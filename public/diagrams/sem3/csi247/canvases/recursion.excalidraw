		{
			"id": "MjGPqeie",
			"type": "text",
			"x": -287.1200541305588,
			"y": 2795.6989484808373,
			"width": 934.9988403320312,
			"height": 75,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "dashed",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "aDV",
			"roundness": null,
			"seed": 1455564044,
			"version": 498,
			"versionNonce": 269287860,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1783786911334,
			"locked": false,
			"text": "Why use Recursion? \nEvery recursive solution has a corresponding iterative solution. However, for complex\nproblems, recursive code is often much shorter, cleaner, and more elegant.",
			"rawText": "Why use Recursion? \nEvery recursive solution has a corresponding iterative solution. However, for complex problems, recursive code is often much shorter, cleaner, and more elegant.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": "VUCRjHb7",
			"originalText": "Why use Recursion? \nEvery recursive solution has a corresponding iterative solution. However, for complex problems, recursive code is often much shorter, cleaner, and more elegant.",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
		{
			"id": "7360NBc5",
			"type": "rectangle",
			"x": -290.42201676823834,
			"y": 2891.957949652132,
			"width": 950.3651014658343,
			"height": 210,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "dashed",
