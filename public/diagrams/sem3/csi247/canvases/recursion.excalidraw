		{
			"id": "aAJ9y7UN",
			"type": "text",
			"x": -292.0567545186336,
			"y": 252.01609873932725,
			"width": 923.9989013671875,
			"height": 175,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "dashed",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "aCG",
			"roundness": null,
			"seed": 1831931060,
			"version": 358,
			"versionNonce": 1224293556,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1783785569064,
			"locked": false,
			"text": "Imagine you are standing at the top of a dark staircase and drop your keys. \nYou ask the person on the step below you, \"Did you find my keys?\" (Recursive Call).\nThey don't have them, so they ask the person below them. \nThis continues until the question reaches the ground floor (Base Case). \nThe person on the ground floor finds the keys! But they can't throw them to the top.\nThey hand them to the person on step 1, who hands them to step 2, who hands them to\nstep 3 (Cascading Return), until they are finally handed back to you at the top.",
			"rawText": "Imagine you are standing at the top of a dark staircase and drop your keys. \nYou ask the person on the step below you, \"Did you find my keys?\" (Recursive Call). They don't have them, so they ask the person below them. \nThis continues until the question reaches the ground floor (Base Case). \nThe person on the ground floor finds the keys! But they can't throw them to the top. They hand them to the person on step 1, who hands them to step 2, who hands them to step 3 (Cascading Return), until they are finally handed back to you at the top.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": "PLjPxxVA",
			"originalText": "Imagine you are standing at the top of a dark staircase and drop your keys. \nYou ask the person on the step below you, \"Did you find my keys?\" (Recursive Call). They don't have them, so they ask the person below them. \nThis continues until the question reaches the ground floor (Base Case). \nThe person on the ground floor finds the keys! But they can't throw them to the top. They hand them to the person on step 1, who hands them to step 2, who hands them to step 3 (Cascading Return), until they are finally handed back to you at the top.",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
		{
			"id": "VUCRjHb7",
