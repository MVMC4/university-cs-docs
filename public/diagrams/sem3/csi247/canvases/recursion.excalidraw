		{
			"id": "egp2e79k",
			"type": "text",
			"x": -285.42201676823834,
			"y": 2896.957949652132,
			"width": 934.9988403320312,
			"height": 200,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "dashed",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "aG",
