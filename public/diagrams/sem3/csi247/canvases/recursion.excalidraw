			"updated": 1783786654100,
			"link": null,
			"locked": false,
			"text": "It cannot finish the math until it hits the bottom (the Base Case) and walks back up.",
			"rawText": "It cannot finish the math until it hits the bottom (the Base Case) and walks back up.",
