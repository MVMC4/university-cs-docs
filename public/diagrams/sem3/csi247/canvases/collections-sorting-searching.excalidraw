			"isDeleted": false,
			"boundElements": [],
			"updated": 1783444463769,
			"locked": false,
			"text": "Time: Best-case: O(1) (Item is at index 0).\n      Worst-case: O(n) (Item is at the very end or not in the collection).\nSpace: O(1) (No extra memory needed; just a few variables).",
			"rawText": "Time: Best-case: O(1) (Item is at index 0).\n      Worst-case: O(n) (Item is at the very end or not in the collection).\nSpace: O(1) (No extra memory needed; just a few variables).",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": "QoPYdtxk",
			"originalText": "Time: Best-case: O(1) (Item is at index 0).\n      Worst-case: O(n) (Item is at the very end or not in the collection).\nSpace: O(1) (No extra memory needed; just a few variables).",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
