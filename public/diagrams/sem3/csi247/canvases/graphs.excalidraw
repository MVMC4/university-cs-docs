			"locked": false,
			"hasTextLink": false
		},
		{
			"id": "CCsyerWc",
			"type": "text",
			"x": -390.05737852367923,
			"y": 3276.434357887907,
			"width": 1077.9986572265625,
			"height": 125,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "dashed",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b0C",
			"roundness": null,
			"seed": 1740131746,
			"version": 433,
			"versionNonce": 1004684670,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1783639052058,
			"locked": false,
			"text": "We must separate the data from the connections.\n  1. The Data: We take all of our nodes (cities, users, etc.) and just drop them into a standard, \n     simple 1D array. We assign each one an ID based on its index (Node 0, Node 1, Node 2...).\n  2. The Connections: We build a completely separate \"Master Ledger\" to keep track of who is \n     connected to whom.",
			"rawText": "We must separate the data from the connections.\n  1. The Data: We take all of our nodes (cities, users, etc.) and just drop them into a standard, \n     simple 1D array. We assign each one an ID based on its index (Node 0, Node 1, Node 2...).\n  2. The Connections: We build a completely separate \"Master Ledger\" to keep track of who is \n     connected to whom.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": "wgoUqPAA",
			"originalText": "We must separate the data from the connections.\n  1. The Data: We take all of our nodes (cities, users, etc.) and just drop them into a standard, \n     simple 1D array. We assign each one an ID based on its index (Node 0, Node 1, Node 2...).\n  2. The Connections: We build a completely separate \"Master Ledger\" to keep track of who is \n     connected to whom.",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
		{
			"id": "7U6WLScY",
			"type": "text",
			"x": -394.02353974199195,
			"y": 3421.8925235531415,
			"width": 972.1766152011238,
			"height": 50,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "dashed",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b0D",
			"roundness": null,
			"seed": 75265086,
			"version": 419,
			"versionNonce": 510482786,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1783639052058,
			"link": null,
			"locked": false,
			"text": "If Node 0 wants to know who it is connected to, it doesn't look inside its own object.\nIt asks the Master Ledger.",
			"rawText": "If Node 0 wants to know who it is connected to, it doesn't look inside its own object. It asks the Master Ledger.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "If Node 0 wants to know who it is connected to, it doesn't look inside its own object. It asks the Master Ledger.",
			"autoResize": false,
			"lineHeight": 1.25,
			"hasTextLink": false
		},
