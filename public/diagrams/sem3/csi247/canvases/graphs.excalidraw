			"seed": 671448062,
			"version": 46,
			"versionNonce": 1960062206,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1783637519135,
			"locked": false,
			"text": "- Arrays/Lists: Force data into a straight, single-file line.\n- Trees: Force data into a strict hierarchy (a boss, managers, and employees).",
			"rawText": "- Arrays/Lists: Force data into a straight, single-file line.\n- Trees: Force data into a strict hierarchy (a boss, managers, and employees).",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "- Arrays/Lists: Force data into a straight, single-file line.\n- Trees: Force data into a strict hierarchy (a boss, managers, and employees).",
