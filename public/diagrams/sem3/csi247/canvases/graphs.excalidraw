			"boundElements": [],
			"updated": 1783629823693,
			"locked": false,
			"text": "In a Tree, nodes have a strict parent-child hierarchy with a single root. \nIn a Graph, there is no root, no hierarchy, and nodes can connect to any other node (including cycles).",
			"rawText": "In a Tree, nodes have a strict parent-child hierarchy with a single root. \nIn a Graph, there is no root, no hierarchy, and nodes can connect to any other node (including cycles).",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "In a Tree, nodes have a strict parent-child hierarchy with a single root. \nIn a Graph, there is no root, no hierarchy, and nodes can connect to any other node (including cycles).",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
