			"version": 446,
			"versionNonce": 2125241662,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1783639052058,
			"link": null,
			"locked": false,
			"text": "Because we cannot store connections inside the nodes themselves anymore, we have to change our entire\nstrategy.",
			"rawText": "Because we cannot store connections inside the nodes themselves anymore, we have to change our entire strategy.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Because we cannot store connections inside the nodes themselves anymore, we have to change our entire strategy.",
			"autoResize": false,
			"lineHeight": 1.25,
			"hasTextLink": false
		},
		{
			"id": "wgoUqPAA",
			"type": "rectangle",
			"x": -395.05737852367923,
			"y": 3271.434357887907,
			"width": 1102.0615239095255,
			"height": 135,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "dashed",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
