			"isDeleted": false,
			"boundElements": [],
			"updated": 1783637508307,
			"locked": false,
			"text": "Up until now, every data structure you have learned forces the real world to obey strict\ncomputer rules.",
			"rawText": "Up until now, every data structure you have learned forces the real world to obey strict computer rules.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Up until now, every data structure you have learned forces the real world to obey strict computer rules.",
			"autoResize": false,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
		{
			"id": "n22OhGne",
			"type": "text",
			"x": -402.4034002245009,
			"y": 1977.9234060962688,
			"width": 857.9989013671875,
			"height": 50,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
