			"updated": 1783639459474,
			"link": null,
			"locked": false,
			"text": "This worked beautifully because a Binary Tree guaranteed a maximum of two connections.",
			"rawText": "This worked beautifully because a Binary Tree guaranteed a maximum of two connections.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "This worked beautifully because a Binary Tree guaranteed a maximum of two connections.",
