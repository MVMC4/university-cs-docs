		{
			"id": "wnv92iD8",
			"type": "text",
			"x": -406.4946940001712,
			"y": 4923.825069657083,
			"width": 1123.4313134178865,
			"height": 50,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "dashed",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b0a",
			"roundness": null,
			"seed": 858030562,
			"version": 92,
			"versionNonce": 374610530,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1783640689263,
			"link": null,
			"locked": false,
			"text": "To resolve the memory overhead of the matrix approach, computer scientists utilize the Adjacency List.\nThis structure optimizes memory allocation by storing only the edges that explicitly exist.",
			"rawText": "To resolve the memory overhead of the matrix approach, computer scientists utilize the Adjacency List. This structure optimizes memory allocation by storing only the edges that explicitly exist.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "To resolve the memory overhead of the matrix approach, computer scientists utilize the Adjacency List. This structure optimizes memory allocation by storing only the edges that explicitly exist.",
