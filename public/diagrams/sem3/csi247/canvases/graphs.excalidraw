			"seed": 890342754,
			"version": 30,
			"versionNonce": 2035668642,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1783683670511,
			"locked": false,
			"text": "In a Graph, we usually do NOT create a custom Node class. Because a graph separates the data from the\nconnections, a \"Node\" in a graph is simply an Integer Index (0, 1, 2, 3, etc.).",
			"rawText": "In a Graph, we usually do NOT create a custom Node class. Because a graph separates the data from the connections, a \"Node\" in a graph is simply an Integer Index (0, 1, 2, 3, etc.).",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": "quwbZGGf",
			"originalText": "In a Graph, we usually do NOT create a custom Node class. Because a graph separates the data from the connections, a \"Node\" in a graph is simply an Integer Index (0, 1, 2, 3, etc.).",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
		{
			"id": "XOXfxhsV",
			"type": "text",
			"x": 814.2314620726889,
			"y": 59.869706837681406,
			"width": 1113.476929657128,
			"height": 50,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "dashed",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b0t",
			"roundness": null,
			"seed": 199138402,
			"version": 87,
			"versionNonce": 904872190,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1783683705506,
			"locked": false,
			"text": "If you want to store actual data (like city names), you just create a standard, simple 1D array to\nhold the names. The index of the array becomes the node's \"ID\".",
			"rawText": "If you want to store actual data (like city names), you just create a standard, simple 1D array to hold the names. The index of the array becomes the node's \"ID\".",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "If you want to store actual data (like city names), you just create a standard, simple 1D array to hold the names. The index of the array becomes the node's \"ID\".",
			"autoResize": false,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
