			"hasTextLink": false
		},
		{
			"id": "LUlS4dKw",
			"type": "rectangle",
			"x": -395.6998419789644,
			"y": 2953.5090007103418,
			"width": 1101.9672476051726,
			"height": 210,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
