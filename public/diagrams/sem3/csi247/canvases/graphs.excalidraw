		{
			"id": "8EkJhfbN",
			"type": "text",
			"x": -397.6243926511328,
			"y": 3220.255090039317,
			"width": 1175.918045972363,
			"height": 50,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "dashed",
