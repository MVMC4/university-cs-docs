			"index": "atV",
			"roundness": null,
			"seed": 1463238818,
			"version": 466,
			"versionNonce": 1024436222,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1783639435848,
			"locked": false,
			"text": "The Graph is the ultimate data structure because it drops all the rules. It allows us to model the\nreal world exactly as it is: a chaotic, interconnected web. Without graphs, we could not build GPS\nnavigation, the internet, or social media friend recommendations.  ",
			"rawText": "The Graph is the ultimate data structure because it drops all the rules. It allows us to model the real world exactly as it is: a chaotic, interconnected web. Without graphs, we could not build GPS navigation, the internet, or social media friend recommendations.  ",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": "miY9tPKl",
			"originalText": "The Graph is the ultimate data structure because it drops all the rules. It allows us to model the real world exactly as it is: a chaotic, interconnected web. Without graphs, we could not build GPS navigation, the internet, or social media friend recommendations.  ",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
