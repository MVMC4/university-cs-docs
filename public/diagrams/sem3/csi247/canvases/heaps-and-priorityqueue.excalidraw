			"locked": false,
			"hasTextLink": false
		},
		{
			"id": "1n8mQn5Y",
			"type": "text",
			"x": 778.709275374242,
			"y": 1020.7571741384647,
			"width": 868.9989013671875,
			"height": 175,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "#fff5f5",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "dashed",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "ab",
			"roundness": null,
			"seed": 1525531198,
			"version": 2688,
			"versionNonce": 1771516798,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1783619953805,
			"locked": false,
			"text": "2. Bubble-Up (Percolate-Up / Up-Heapify):\n  - Compare the newly inserted node with its Parent.\n  - If the Heap Invariant is violated (e.g., in a Min-Heap, New Node < Parent):\n    SWAP THEM.\n  - Repeat this comparison upward until either:\n      a) The Parent is smaller/equal to the new node (invariant restored), OR\n      b) The new node reaches the Root (index 0).",
			"rawText": "2. Bubble-Up (Percolate-Up / Up-Heapify):\n  - Compare the newly inserted node with its Parent.\n  - If the Heap Invariant is violated (e.g., in a Min-Heap, New Node < Parent): \n    SWAP THEM.\n  - Repeat this comparison upward until either:\n      a) The Parent is smaller/equal to the new node (invariant restored), OR\n      b) The new node reaches the Root (index 0).",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": "rM3EYxL2",
			"originalText": "2. Bubble-Up (Percolate-Up / Up-Heapify):\n  - Compare the newly inserted node with its Parent.\n  - If the Heap Invariant is violated (e.g., in a Min-Heap, New Node < Parent): \n    SWAP THEM.\n  - Repeat this comparison upward until either:\n      a) The Parent is smaller/equal to the new node (invariant restored), OR\n      b) The new node reaches the Root (index 0).",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
		{
			"id": "VC4fj75c",
			"type": "rectangle",
			"x": 772.1913692167057,
			"y": 922.6712286326222,
			"width": 883.6577350287596,
			"height": 85,
			"angle": 0,
			"strokeColor": "#1e1e1e",
