			"isDeleted": false,
			"boundElements": [],
			"updated": 1783611097496,
			"locked": false,
			"text": "Visualizing the Shift:\n\nPOINTER WAY (AVL):            ARRAY WAY (HEAP):\n    node.left           -->      heap[2 * i + 1]\n    node.right          -->      heap[2 * i + 2]\n    node.parent         -->      heap[(i - 1) / 2]",
			"rawText": "Visualizing the Shift:\n\nPOINTER WAY (AVL):            ARRAY WAY (HEAP):\n    node.left           -->      heap[2 * i + 1]\n    node.right          -->      heap[2 * i + 2]\n    node.parent         -->      heap[(i - 1) / 2]",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": "Z4EoC57b",
			"originalText": "Visualizing the Shift:\n\nPOINTER WAY (AVL):            ARRAY WAY (HEAP):\n    node.left           -->      heap[2 * i + 1]\n    node.right          -->      heap[2 * i + 2]\n    node.parent         -->      heap[(i - 1) / 2]",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
