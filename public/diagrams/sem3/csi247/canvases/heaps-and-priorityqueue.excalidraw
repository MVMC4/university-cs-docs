			"text": "Why Don't We Use Pointers for Binary Heaps?",
			"rawText": "Why Don't We Use Pointers for Binary Heaps?",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Why Don't We Use Pointers for Binary Heaps?",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false
		},
		{
			"id": "a1Nv1wZZmo8xo6kpFgFNW",
			"type": "line",
			"x": -388.972890803666,
			"y": 1572.5828722516123,
			"width": 471.9197174038586,
			"height": 0.6532624327144276,
			"angle": 0,
			"strokeColor": "#1971c2",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
