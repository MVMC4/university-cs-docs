			"boundElements": [],
			"updated": 1783607446775,
			"locked": false,
			"text": "Important Note: A Heap is NOT a Binary Search Tree (BST)! \nThere is no left-vs-right ordering constraint. \nThe only rule is that parents are smaller (or larger) than their children.",
			"rawText": "Important Note: A Heap is NOT a Binary Search Tree (BST)! \nThere is no left-vs-right ordering constraint. \nThe only rule is that parents are smaller (or larger) than their children.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": "23iU57Tj",
			"originalText": "Important Note: A Heap is NOT a Binary Search Tree (BST)! \nThere is no left-vs-right ordering constraint. \nThe only rule is that parents are smaller (or larger) than their children.",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
