		{
			"id": "ngzB0Cna",
			"type": "text",
			"x": 777.1913692167057,
			"y": 927.6712286326222,
			"width": 714.9990234375,
			"height": 75,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "dashed",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "acV",
			"roundness": null,
			"seed": 2035009982,
			"version": 2475,
			"versionNonce": 295703486,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1783619953805,
