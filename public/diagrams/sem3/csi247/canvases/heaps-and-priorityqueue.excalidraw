			"index": "aK",
			"roundness": null,
			"seed": 668975358,
			"version": 1576,
			"versionNonce": 583332130,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1783607446775,
			"locked": false,
			"text": "Min-Heap: Parent ≤ Children. (The absolute smallest item in the whole tree sits at the Root).\nMax-Heap: Parent ≥ Children. (The absolute largest item in the whole tree sits at the Root).",
			"rawText": "Min-Heap: Parent ≤ Children. (The absolute smallest item in the whole tree sits at the Root).\nMax-Heap: Parent ≥ Children. (The absolute largest item in the whole tree sits at the Root).",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "middle",
			"containerId": null,
			"originalText": "Min-Heap: Parent ≤ Children. (The absolute smallest item in the whole tree sits at the Root).\nMax-Heap: Parent ≥ Children. (The absolute largest item in the whole tree sits at the Root).",
			"autoResize": false,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
