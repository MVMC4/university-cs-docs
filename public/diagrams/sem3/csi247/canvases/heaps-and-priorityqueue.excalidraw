			"updated": 1783619955498,
			"locked": false,
			"text": "How \"Bubble-Down\" (Deletion / Extract-Min) Works",
			"rawText": "How \"Bubble-Down\" (Deletion / Extract-Min) Works",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "How \"Bubble-Down\" (Deletion / Extract-Min) Works",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
		{
			"id": "lkPlbjnM",
			"type": "text",
			"x": 774.6365305036015,
			"y": 3454.0820593347294,
			"width": 856.6331159700161,
			"height": 123.81775639822422,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "#fff5f5",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "dashed",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b2m",
			"roundness": null,
			"seed": 85281086,
			"version": 2737,
			"versionNonce": 1981784830,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1783620440751,
			"locked": false,
			"text": "In a Min-Heap, extracting the top priority element means removing the Root.\n\nRemoving the Root leaves a hole at the top of the tree. \nTo fill it without ruining the tree's shape, we use a clever technique: swap\nthe Root with the last leaf node, remove the leaf, and then Bubble-Down.",
			"rawText": "In a Min-Heap, extracting the top priority element means removing the Root.\n\nRemoving the Root leaves a hole at the top of the tree. \nTo fill it without ruining the tree's shape, we use a clever technique: swap the Root with the last leaf node, remove the leaf, and then Bubble-Down.",
			"fontSize": 19.810841023715874,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "In a Min-Heap, extracting the top priority element means removing the Root.\n\nRemoving the Root leaves a hole at the top of the tree. \nTo fill it without ruining the tree's shape, we use a clever technique: swap the Root with the last leaf node, remove the leaf, and then Bubble-Down.",
			"autoResize": false,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
