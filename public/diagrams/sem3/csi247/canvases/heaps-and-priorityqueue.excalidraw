		},
		{
			"id": "KyjROq3X",
			"type": "text",
			"x": -382.7944489522306,
			"y": 1586.4254155016222,
			"width": 1076.862032431845,
			"height": 75,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "dashed",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b2D",
			"roundness": null,
			"seed": 1087617634,
			"version": 188,
			"versionNonce": 681141474,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1783609231771,
			"locked": false,
			"text": "A Binary Heap comes with one strict structural rule that AVL trees do not have: It MUST be a\nComplete Binary Tree. Every single level must be completely filled from left to right, with zero\nmissing nodes or gaps.",
			"rawText": "A Binary Heap comes with one strict structural rule that AVL trees do not have: It MUST be a Complete Binary Tree. Every single level must be completely filled from left to right, with zero missing nodes or gaps.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "A Binary Heap comes with one strict structural rule that AVL trees do not have: It MUST be a Complete Binary Tree. Every single level must be completely filled from left to right, with zero missing nodes or gaps.",
			"autoResize": false,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
		{
			"id": "zcelW68t",
			"type": "rectangle",
			"x": -378.6903947351301,
			"y": 2285.6440664335096,
			"width": 1080.3752215340762,
			"height": 110,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "#e3fafc",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "dashed",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b2E",
			"roundness": null,
			"seed": 51087742,
			"version": 432,
			"versionNonce": 1429221538,
			"isDeleted": false,
			"boundElements": [
				{
					"type": "text",
					"id": "zPeowLZU"
				}
			],
			"updated": 1783609327710,
			"link": null,
			"locked": false,
			"hasTextLink": false
		},
		{
			"id": "zPeowLZU",
			"type": "text",
			"x": -373.6903947351301,
			"y": 2290.6440664335096,
			"width": 1055.998779296875,
			"height": 100,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "dashed",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b2F",
			"roundness": null,
			"seed": 35840226,
			"version": 344,
			"versionNonce": 2040668798,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1783609327710,
			"locked": false,
			"text": "We aren't changing how trees work conceptually—we are changing how we store them in memory. \nAn AVL tree uses explicit pointers because its shape changes dynamically with missing branches. \nA Heap uses implicit math because its strict left-to-right shape lets us map every node directly\nto an array slot without wasting memory on pointers.",
			"rawText": "We aren't changing how trees work conceptually—we are changing how we store them in memory. \nAn AVL tree uses explicit pointers because its shape changes dynamically with missing branches. \nA Heap uses implicit math because its strict left-to-right shape lets us map every node directly to an array slot without wasting memory on pointers.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": "zcelW68t",
			"originalText": "We aren't changing how trees work conceptually—we are changing how we store them in memory. \nAn AVL tree uses explicit pointers because its shape changes dynamically with missing branches. \nA Heap uses implicit math because its strict left-to-right shape lets us map every node directly to an array slot without wasting memory on pointers.",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
		{
			"id": "awJMlep7",
			"type": "image",
			"x": -386.2855970212829,
			"y": 1663.304126614748,
			"width": 825.369668827273,
			"height": 254.39200708824933,
			"angle": 0,
			"strokeColor": "transparent",
			"backgroundColor": "#e3fafc",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "dashed",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b2G",
			"roundness": null,
			"seed": 519465470,
			"version": 263,
			"versionNonce": 1840731390,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1783609257449,
			"link": null,
			"locked": false,
			"status": "pending",
			"fileId": "535676c756d1351353f90d35c013d3ee8fe0c9a4",
			"scale": [
				1,
				1
			],
			"crop": {
				"x": 40.95577080622934,
				"y": 42.09634925301356,
				"width": 1284.503668962467,
				"height": 395.9043793357102,
				"naturalWidth": 1366,
				"naturalHeight": 476
			},
			"hasTextLink": false
		},
		{
			"text": "Because a Heap guarantees no empty gaps, we get a huge optimization opportunity:\nwe don't need pointers at all!",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"id": "JmFb7FWo",
			"type": "text",
			"x": -382.2730668654745,
			"y": 1923.182217955879,
			"width": 887.3487477675892,
			"height": 50,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "hachure",
			"strokeWidth": 1,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"roundness": null,
			"seed": 72326,
			"version": 247,
			"versionNonce": 1024881278,
			"updated": 1783609274103,
			"isDeleted": false,
			"groupIds": [],
			"boundElements": [],
			"locked": false,
			"frameId": null,
			"hasTextLink": false,
			"containerId": null,
			"originalText": "Because a Heap guarantees no empty gaps, we get a huge optimization opportunity: \nwe don't need pointers at all!",
			"rawText": "Because a Heap guarantees no empty gaps, we get a huge optimization opportunity: \nwe don't need pointers at all!",
			"lineHeight": 1.25,
			"autoResize": false,
			"index": "b2H",
			"link": null
		},
