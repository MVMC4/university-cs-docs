			"isDeleted": false,
			"boundElements": [],
			"updated": 1783620422541,
			"locked": false,
			"text": "2. Move Last Leaf to Root: \nTake the very last element in the tree (bottom-rightmost leaf) and overwrite the\nRoot with it. \n   Decrease tree size by 1.",
			"rawText": "2. Move Last Leaf to Root: \nTake the very last element in the tree (bottom-rightmost leaf) and overwrite the Root with it. \n   Decrease tree size by 1.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": "vRTbRl_nzLjKlJMqaP4a1",
			"originalText": "2. Move Last Leaf to Root: \nTake the very last element in the tree (bottom-rightmost leaf) and overwrite the Root with it. \n   Decrease tree size by 1.",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
