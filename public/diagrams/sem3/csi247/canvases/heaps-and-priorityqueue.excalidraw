			"updated": 1783608784129,
			"link": null,
			"locked": false,
			"text": "Up until now, with Binary Search Trees (BSTs) and AVL Trees, every tree node was an object holding\nreferences to its children:",
			"rawText": "Up until now, with Binary Search Trees (BSTs) and AVL Trees, every tree node was an object holding references to its children:",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Up until now, with Binary Search Trees (BSTs) and AVL Trees, every tree node was an object holding references to its children:",
			"autoResize": false,
			"lineHeight": 1.25,
			"hasTextLink": false
		},
