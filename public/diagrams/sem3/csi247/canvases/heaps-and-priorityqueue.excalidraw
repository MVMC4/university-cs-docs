			"updated": 1783617693478,
			"link": null,
			"locked": false,
			"text": "How \"Bubble-Up\" (Insertion) Works",
			"rawText": "How \"Bubble-Up\" (Insertion) Works",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "How \"Bubble-Up\" (Insertion) Works",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false
		},
		{
			"id": "JlCKrkRK",
			"type": "text",
			"x": 773.7165459950768,
			"y": 817.8546056647904,
			"width": 856.6331159700161,
			"height": 74.29065383893453,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "#fff5f5",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "dashed",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "aZ",
			"roundness": null,
			"seed": 229852158,
			"version": 2347,
			"versionNonce": 1375052386,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1783617706857,
			"link": null,
			"locked": false,
			"text": "When you insert a new element into a Heap, you cannot just drop it anywhere.\nYou must put it in the position that maintains the Complete Binary Tree shape,\nthen restore the Heap Order Invariant.",
			"rawText": "When you insert a new element into a Heap, you cannot just drop it anywhere. You must put it in the position that maintains the Complete Binary Tree shape, then restore the Heap Order Invariant.",
			"fontSize": 19.810841023715874,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "When you insert a new element into a Heap, you cannot just drop it anywhere. You must put it in the position that maintains the Complete Binary Tree shape, then restore the Heap Order Invariant.",
			"autoResize": false,
			"lineHeight": 1.25,
			"hasTextLink": false
		},
		{
			"id": "rM3EYxL2",
			"type": "rectangle",
			"x": 773.709275374242,
			"y": 1015.7571741384647,
			"width": 884.1398289994295,
			"height": 185,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "dashed",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
