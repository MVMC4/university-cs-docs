			"updated": 1783610979606,
			"locked": false,
			"text": "Now that we know the tree is stored inside a flat array [0, 1, 2, 3, ...], how do we do the job of\nnode.left or node.parent without using pointers?",
			"rawText": "Now that we know the tree is stored inside a flat array [0, 1, 2, 3, ...], how do we do the job of node.left or node.parent without using pointers?",
			"fontSize": 20,
			"fontFamily": 8,
