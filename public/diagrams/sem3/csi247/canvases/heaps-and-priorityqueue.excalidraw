			"index": "b24",
			"roundness": null,
			"seed": 760481598,
			"version": 146,
			"versionNonce": 1310927742,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1783608781078,
			"locked": false,
			"text": "This pointer-based approach was necessary because AVL trees constantly re-balance, rotate, and can\nhave \"gaps\" (e.g., a node might have a right child but no left child). Pointers allow nodes to live\nanywhere in memory.",
			"rawText": "This pointer-based approach was necessary because AVL trees constantly re-balance, rotate, and can have \"gaps\" (e.g., a node might have a right child but no left child). Pointers allow nodes to live anywhere in memory.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "This pointer-based approach was necessary because AVL trees constantly re-balance, rotate, and can have \"gaps\" (e.g., a node might have a right child but no left child). Pointers allow nodes to live anywhere in memory.",
			"autoResize": false,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
