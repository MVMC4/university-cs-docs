			"seed": 1647617698,
			"version": 35,
			"versionNonce": 1983904290,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1783611439007,
			"locked": false,
			"text": "The Tree (How we see it):\n          [A]              <-- Level 0\n        /     \\\n      [B]     [C]          <-- Level 1\n     /   \\   /   \\\n   [D]  [E] [F]  [G]       <-- Level 2\n\nThe Array (How the computer stores it):\nIndex:  [0]  [1]  [2]  [3]  [4]  [5]  [6]\nValue:  [A]  [B]  [C]  [D]  [E]  [F]  [G]",
			"rawText": "The Tree (How we see it):\n          [A]              <-- Level 0\n        /     \\\n      [B]     [C]          <-- Level 1\n     /   \\   /   \\\n   [D]  [E] [F]  [G]       <-- Level 2\n\nThe Array (How the computer stores it):\nIndex:  [0]  [1]  [2]  [3]  [4]  [5]  [6]\nValue:  [A]  [B]  [C]  [D]  [E]  [F]  [G]",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": "XSGTTfGs",
			"originalText": "The Tree (How we see it):\n          [A]              <-- Level 0\n        /     \\\n      [B]     [C]          <-- Level 1\n     /   \\   /   \\\n   [D]  [E] [F]  [G]       <-- Level 2\n\nThe Array (How the computer stores it):\nIndex:  [0]  [1]  [2]  [3]  [4]  [5]  [6]\nValue:  [A]  [B]  [C]  [D]  [E]  [F]  [G]",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
