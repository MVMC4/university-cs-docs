		{
			"id": "VUPCdsyu",
			"type": "text",
			"x": -384.9128466487769,
			"y": 157.6989391025902,
			"width": 1011.9987182617188,
			"height": 125,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "dashed",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "a8",
			"roundness": null,
			"seed": 1028632482,
			"version": 323,
			"versionNonce": 2057475746,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1783607403554,
			"locked": false,
			"text": "Min-Priority Queue: The element with the lowest numerical value is served first.\n  - For example, with elements 4, 6, 8, 9, and 10. \n    4 will be dequeued first since it has the smallest value, and the dequeue operation will\n    return 4.\nMax-Priority Queue: The element with the highest numerical value is served first.",
			"rawText": "Min-Priority Queue: The element with the lowest numerical value is served first.\n  - For example, with elements 4, 6, 8, 9, and 10. \n    4 will be dequeued first since it has the smallest value, and the dequeue operation will \n    return 4.\nMax-Priority Queue: The element with the highest numerical value is served first.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": "nkRqhKBr",
			"originalText": "Min-Priority Queue: The element with the lowest numerical value is served first.\n  - For example, with elements 4, 6, 8, 9, and 10. \n    4 will be dequeued first since it has the smallest value, and the dequeue operation will \n    return 4.\nMax-Priority Queue: The element with the highest numerical value is served first.",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
