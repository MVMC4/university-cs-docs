			"updated": 1783595690532,
			"link": null,
			"locked": false,
			"text": "In a standard Queue (FIFO), the first person in line is served first.\nIn a Priority Queue, elements are served based on priority level.",
			"rawText": "In a standard Queue (FIFO), the first person in line is served first. In a Priority Queue, elements are served based on priority level.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "In a standard Queue (FIFO), the first person in line is served first. In a Priority Queue, elements are served based on priority level.",
			"autoResize": false,
			"lineHeight": 1.25,
			"hasTextLink": false
		},
