nted programming language.\n* Why: Platform-independent (Write Once, Run Anywhere) via the Java Virtual Machine (JVM), \n  heavily typed for safety.\n* When: Used for backend enterprise systems, Android apps, and large-scale processing.\n* How: Code is written in .java files, compiled into bytecode (.class files), and executed by \n  the JVM.","autoResize":false,"lineHeight":1.25,"hasTextLink":false,"link":null},{"id":"ZZxybf1KxbsPd5DgejnIu","type":"line","x":-599.210270919098,"y":-2158.43211399267,"width":286.7983398846171,"height":0.5579649264655018,"angle":0,"strokeColor":"#1971c2","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"aS","roundness":null,"seed":1951483568,"version":111,"versionNonce":77402288,"isDeleted":false,"boundElements":[],"updated":1785959479905,"link":null,"locked":false,"points":[[0,0],[286.7983398846171,0.5579649264655018]],"startBinding":null,"endBinding":null,"startArrowhead":null,"endArrowhead":null,"polygon":false,"hasTextLink":false},{"id":"bJqHhyhZ","type":"rectangle","x":-606.245539,"y":-2181.9451838353298,"width":1037.9506107534753,"height":181.16917130857968,"angle":0,"strokeColor":"#1971c2","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"aT","roundness":null,"seed":278296144,"version":138,"versionNonce":448590928,"isDeleted":false,"boundElements":[],"updated":1785959485462,"link":null,"locked":false,"hasTextLink":false},{"id":"XQzRUY5u","type":"text","x":-600.6923747972129,"y":-1981.1160385832777,"width":319,"height":25,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"aU","roundness":null,"seed":313387184,"version":69,"versionNonce":411977808,"isDeleted":false,"boundElements":[],"u