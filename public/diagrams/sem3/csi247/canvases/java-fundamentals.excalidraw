182798691536,"y":-1801.5039248452867,"width":220,"height":25,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"aY","roundness":null,"seed":1960965808,"version":150,"versionNonce":846850128,"isDeleted":false,"boundElements":[],"updated":1785963171062,"locked":false,"text":"Data Types & Casting","rawText":"Data Types & Casting","fontSize":20,"fontFamily":8,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Data Types & Casting","autoResize":true,"lineHeight":1.25,"hasTextLink":false,"link":null},{"id":"xUU4h4ylrW2m5mVDXFSm8","type":"line","x":-589.5994342179501,"y":-1780.155050819954,"width":218.64793915732992,"height":0.20902922653863243,"angle":0,"strokeColor":"#1971c2","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"dashed","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"aZ","roundness":null,"seed":2137494096,"version":128,"versionNonce":951289008,"isDeleted":false,"boundElements":[],"updated":1785963171062,"link":null,"locked":false,"points":[[0,0],[218.64793915732992,-0.20902922653863243]],"startBinding":null,"endBinding":null,"startArrowhead":null,"endArrowhead":null,"polygon":false,"hasTextLink":false},{"id":"daecZWnv","type":"text","x":-590.8740505138735,"y":-1772.3920677196786,"width":1011.3060027235226,"height":125,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"dashed","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"aa","roundness":null,"seed":1266447440,"version":155,"versionNonce":28859984,"isDeleted":false,"boundElements":[],"updated":1785963171062,"locked":false,"text":"* What: Categorizing data (numbers, text, true/false).\n* Why: Java is \"strongly typed.\" You must declare what type of data a variable holds so \n  Java can allocate the exact right amount of memory and prevent you from accidentally \n  doing math with words.\n* Primitives: int (5), double (3.14), boolean (true/false), char ('A').","rawText":"* What: Categorizing data (numbers, text, true/false).\n* Why: Java is \"strongly typed.\" You must declare what type of data a variable holds so \n  Java can allocate the exact right amount of memory and prevent you from accidentally \n  doing math with words.\n* Primitives: int (5), double (3.14), boolean (true/false), char ('A').","fontSize":20,"fontFamily":8,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"* What: Categorizing data (numbers, text, true/false).\n* Why: Java is \"strongly typed.\" You must declare what type of data a variable holds so \n  Java can allocate the exact right amount of memory and prevent you from accidentally \n  doing math with words.\n* Primitives: int (5), double (3.14), boolean (true/false), char ('A').","autoResize":false,"lineHeight":1.25,"hasTextLink":false,"link":null},{"id":"Di6FQXk4","type":"text","x":-581.5308375809409,"y":-1643.8237069798222,"width":385,"height":25,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"dashed","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"ab","roundness":null,"seed":824894128,"version":76,"versionNonce":1530883760,"isDeleted":false,"boundElements":[],"updated":1785963171062,"locked":false,"text":"Type Casting (Changing Data Types):","rawText":"Type Casting (Changing Data Types):","fontSize":20,"fontFamily":8,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Type Casting (Changing Data Types):","autoResize":true,"lineHeight":1.25,"hasTextLink":false,"link":null},{"id":"wMAm48uMOlp_PfloCkI5q","type":"line","x":-576.7636305704676,"y":-1621.3482518826943,"width":376.807983437251,"height":0.5973021036722912,"angle":0,"strokeColor":"#1971c2","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"dashed","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"ac","roundness":null,"seed":1836124752,"version":179,"versionNonce":230167632,"isDeleted":false,"boundElements":[],"updated":1785963171062,"link":null,"locked":false,"points":[[0,0],[376.807983437251,0.5973021036722912]],"startBinding":null,"endBinding":null,"startArrowhead":null,"endArrowhead":null,"polygon":false,"hasTextLink":false},{"id":"liukszpD","type":"rectangle","x":-573.8251835226398,"y":-1476.7118982138159,"width":973.3644325427792,"height":250.3907054257747,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"#fff9db","fillStyle":"solid","strokeWidth":1,"strokeStyle":"dashed","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"ad","roundness":null,"seed":376292432,"version":476,"versionNonce":1488853168,"isDeleted":false,"boundElements":[],"updated":1785963171062,"link":null,"locked":false,"hasTextLink":false},{"id":"asVboO4g","type":"text","x":-574.264492579225,"y":-1609.4299827149453,"width":953.0712905411922,"height":125,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"ag","roundness":null,"seed":1972211792,"version":560,"versionNonce":1662223952,"isDeleted":false,"boundElements":[],"updated":1785964023169,"locked":false,"text":"- Implicit Casting (Widening): Automatic. Moving from a smaller box to a larger box \n  (int -> double). No data is lost. int x = 5; double y = x; // y is 5.0\n- Explicit Casting (Narrowing): Manual. Moving from a larger box to a smaller one \n  (double -> int). Requires parentheses because data will be lost (decimals get \n  chopped off, not rounded).","rawText":"- Implicit Casting (Widening): Automatic. Moving from a smaller box to a larger box \n  (int -> double). No data is lost. int x = 5; double y = x; // y is 5.0\n- Explicit Casting (Narrowing): Manual. Moving from a larger box to a smaller one \n  (double -> int). Requires parentheses because data will be lost (decimals get \n  chopped off, not rounded).","fontSize":20,"fontFamily":8,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"- Implicit Casting (Widening): Automatic. Moving from a smaller box to a larger box \n  (int -> double). No data is lost. int x = 5; double y = x; // y is 5.0\n- Explicit Casting (Narrowing): Manual. Moving from a larger box to a smaller one \n  (double -> int). Requires parentheses because data will be lost (decimals get \n  chopped off, not rounded).","autoResize":false,"lineHeight":1.25,"hasTextLink":false,"link":null},{"id":"qmwiSSOq","type":"text","x":-569.4172767326571,"y":-1466.6634083616673,"width":220,"height":25,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"#e3fafc","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"ah","roundness":null,"seed":2101087920,"version":91,"versionNonce":1154974384,"isDeleted":false,"boundElements":[],"updated":1785963171062,"locked":false,"text":"TRICK QUESTION ALERT","rawText":"TRICK QUESTION ALERT","fontSize":20,"fontFamily":8,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"TRICK QUESTION ALERT","autoResize":true,"lineHeight":1.25,"hasTextLink":false,"link":null},{"id":"rUR1d5Ei","type":"text","x":-567.9818554191808,"y":-1440.8315685400053,"width":978.1203681573887,"height":75,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"#e3fafc","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"ak","roundness":null,"seed":1231673936,"version":161,"versionNonce":945504336,"isDeleted":false,"boundElements":[],"updated":1785963171062,"locked":false,"text":"Integer Division:\nIf you divide two integers, Java will ALWAYS output an integer. \nIt \"narrows\" the result by completely chopping off the decimal.","rawText":"Integer Division:\nIf you divide two integers, Java will ALWAYS output an integer. \nIt \"narrows\" the result by completely chopping off the decimal.","fontSize":20,"fontFamily":8,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Integer Division:\nIf you divide two integers, Java will ALWAYS output an integer. \nIt \"narrows\" the result by completely chopping off the decimal.","autoResize":false,"lineHeight":1.25,"hasTextLink":false,"link":null},{"id":"tX1eCQT4QicaObXniIMzO","type":"line","x":-565.8880608672755,"y":-1445.2152518787132,"width":216.44155101755342,"height":1.1577472377950926,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"#e3fafc","fillStyle":"solid","strokeWidth":1,"strokeStyle":"dashed","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"al","roundness":null,"seed":634961072,"version":155,"versionNonce":2117315760,"isDeleted":false,"boundElements":[],"updated":1785963171062,"link":null,"locked":false,"points":[[0,0],[216.44155101755342,-1.1577472377950926]],"startBinding":null,"endBinding":null,"startArrowhead":null,"endArrowhead":null,"polygon":false,"hasTextLink":false},{"id":"jkkPhtbM","type":"rectangle","x":-587.1232493746135,"y":-1645.9440239345786,"width":995.2751541029637,"height":427.9109174547358,"angle":0,"strokeColor":"#1971c2","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"dashed","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"am","roundness":null,"seed":1821849680,"version":263,"versionNonce":1907275344,"isDeleted":false,"boundElements":[],"updated":1785963171062,"link":null,"locked":false,"hasTextLink":false},{"id":"dPnDW1df","type":"image","x":-568.279668647536,"y":-1365.6901330571352,"width":639.4729933862627,"height":132.17161922826608,"angle":0,"strokeColor":"transparent","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"dashed","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"an","roundness