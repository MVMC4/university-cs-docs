			"index": "b4U",
			"roundness": null,
			"seed": 61674892,
			"version": 1752,
			"versionNonce": 2069965068,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1783719512246,
			"locked": false,
			"text": "Concept: Prioritizes finding the correct element for a specific index, performing exactly one\nswap per pass.\nRequirements: Requires O(1) auxiliary space.\nTime Complexity: \n- Best: O(N^2)\n- Average: O(N^2)\n- Worst: O(N^2)",
			"rawText": "Concept: Prioritizes finding the correct element for a specific index, performing exactly one swap per pass.\nRequirements: Requires O(1) auxiliary space.\nTime Complexity: \n- Best: O(N^2)\n- Average: O(N^2)\n- Worst: O(N^2)",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": "xckLZd0aw28jwZej9wDE7",
			"originalText": "Concept: Prioritizes finding the correct element for a specific index, performing exactly one swap per pass.\nRequirements: Requires O(1) auxiliary space.\nTime Complexity: \n- Best: O(N^2)\n- Average: O(N^2)\n- Worst: O(N^2)",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
