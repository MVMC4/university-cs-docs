			"verticalAlign": "top",
			"containerId": null,
			"originalText": "A stable, in-place algorithm that builds the final sorted array one item at a time by picking the next unsorted element and continuously shifting larger elements to the right to make room for it.",
			"autoResize": false,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
