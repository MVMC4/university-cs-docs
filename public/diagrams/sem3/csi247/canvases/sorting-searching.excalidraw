			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "dashed",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b58",
			"roundness": null,
			"seed": 1185292684,
			"version": 2138,
			"versionNonce": 1653509556,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1783726377876,
			"locked": false,
			"text": "Concept: Assumes the first element is already sorted. It then grabs the next element and\ncompares it backwards against the sorted portion, shifting larger elements rightwards until it\nfinds the correct empty slot to insert the grabbed element.\nRequirements: Requires O(1) auxiliary space. The recursive approach requires O(N) space on the\ncall stack. Highly efficient on arrays that are already partially sorted.\nTime Complexity: \n- Best: O(N) (If the array is already perfectly sorted, the inner loop never executes).\n- Average: O(N^2)\n- Worst: O(N^2) (If the array is sorted in reverse order, requiring maximum shifting).",
			"rawText": "Concept: Assumes the first element is already sorted. It then grabs the next element and compares it backwards against the sorted portion, shifting larger elements rightwards until it finds the correct empty slot to insert the grabbed element.\nRequirements: Requires O(1) auxiliary space. The recursive approach requires O(N) space on the call stack. Highly efficient on arrays that are already partially sorted.\nTime Complexity: \n- Best: O(N) (If the array is already perfectly sorted, the inner loop never executes).\n- Average: O(N^2)\n- Worst: O(N^2) (If the array is sorted in reverse order, requiring maximum shifting).",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": "0IL_GkYXgnmprSnoa9i_5",
			"originalText": "Concept: Assumes the first element is already sorted. It then grabs the next element and compares it backwards against the sorted portion, shifting larger elements rightwards until it finds the correct empty slot to insert the grabbed element.\nRequirements: Requires O(1) auxiliary space. The recursive approach requires O(N) space on the call stack. Highly efficient on arrays that are already partially sorted.\nTime Complexity: \n- Best: O(N) (If the array is already perfectly sorted, the inner loop never executes).\n- Average: O(N^2)\n- Worst: O(N^2) (If the array is sorted in reverse order, requiring maximum shifting).",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
