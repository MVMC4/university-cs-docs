		{
			"id": "QIyFtFSf",
			"type": "text",
			"x": -1832.3338329960459,
			"y": 4788.891593012607,
			"width": 681.9990844726562,
			"height": 100,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "dashed",
