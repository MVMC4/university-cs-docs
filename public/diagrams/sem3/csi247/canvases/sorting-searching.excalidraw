		{
			"id": "y01HYZXj",
			"type": "text",
			"x": 1541.483835510422,
			"y": 589.3754536557924,
			"width": 1066.9986572265625,
			"height": 125,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "#e7f5ff",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "dashed",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b5A",
			"roundness": null,
			"seed": 450637452,
			"version": 1892,
			"versionNonce": 151333132,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1783726407090,
			"locked": false,
			"text": "Imagine playing a card game and picking up cards from the table one by one. Your left hand holds\nthe sorted cards. \nWhen you pick up a new card with your right hand, you scan the cards in your left hand from right\nto left, sliding the larger cards over to make a gap, and insert the new card exactly where it\nbelongs.",
			"rawText": "Imagine playing a card game and picking up cards from the table one by one. Your left hand holds the sorted cards. \nWhen you pick up a new card with your right hand, you scan the cards in your left hand from right to left, sliding the larger cards over to make a gap, and insert the new card exactly where it belongs.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": "be4F6jgUiyROqNBlhHOR9",
			"originalText": "Imagine playing a card game and picking up cards from the table one by one. Your left hand holds the sorted cards. \nWhen you pick up a new card with your right hand, you scan the cards in your left hand from right to left, sliding the larger cards over to make a gap, and insert the new card exactly where it belongs.",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
