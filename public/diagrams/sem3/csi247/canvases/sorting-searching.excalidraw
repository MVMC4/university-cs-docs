			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b2d",
			"roundness": null,
			"seed": 1188784446,
			"version": 4998,
			"versionNonce": 1959270668,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1783715423948,
			"locked": false,
			"text": "When to pick it\n- When dealing with massive datasets that are already sorted,\nor in systems where data is sorted once but searched thousands\nof times (e.g., standard database indexing).",
			"rawText": "When to pick it\n- When dealing with massive datasets that are already sorted, or in systems where data is sorted once but searched thousands of times (e.g., standard database indexing).",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": "-pSHwJRdOkvXeMZcRIFqd",
			"originalText": "When to pick it\n- When dealing with massive datasets that are already sorted, or in systems where data is sorted once but searched thousands of times (e.g., standard database indexing).",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
		{
			"id": "8TDEJ5Me",
			"type": "text",
			"x": -1834.1283451327313,
			"y": 5038.151748247668,
			"width": 1061.737362132353,
			"height": 125,
			"angle": 0,
			"strokeColor": "#e03131",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "dashed",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b2e",
			"roundness": null,
			"seed": 743936382,
			"version": 5246,
			"versionNonce": 1275677492,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1783717421521,
			"locked": false,
			"text": "Limitations: Completely useless on unsorted data; the cost of sorting an array (O(N log N)) just\nto perform one Binary Search is higher than just doing a Linear Search (O(N)). \nFurthermore, it is terribly inefficient for Linked Lists, as finding the \"middle\" element of a\nLinked List requires traversing it (O(N)), defeating the purpose of jumping directly to the\nmidpoint.",
			"rawText": "Limitations: Completely useless on unsorted data; the cost of sorting an array (O(N log N)) just to perform one Binary Search is higher than just doing a Linear Search (O(N)). \nFurthermore, it is terribly inefficient for Linked Lists, as finding the \"middle\" element of a Linked List requires traversing it (O(N)), defeating the purpose of jumping directly to the midpoint.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Limitations: Completely useless on unsorted data; the cost of sorting an array (O(N log N)) just to perform one Binary Search is higher than just doing a Linear Search (O(N)). \nFurthermore, it is terribly inefficient for Linked Lists, as finding the \"middle\" element of a Linked List requires traversing it (O(N)), defeating the purpose of jumping directly to the midpoint.",
			"autoResize": false,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
