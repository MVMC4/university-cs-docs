			"versionNonce": 2121169420,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1783717534091,
			"locked": false,
			"text": "Why Pick It Over Selection Sort: \nBubble Sort is a stable sort (identical values retain their original relative order), whereas\nstandard Selection Sort is unstable.",
			"rawText": "Why Pick It Over Selection Sort: \nBubble Sort is a stable sort (identical values retain their original relative order), whereas standard Selection Sort is unstable.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": "nL0LLwNx59volVxKQfvPd",
			"originalText": "Why Pick It Over Selection Sort: \nBubble Sort is a stable sort (identical values retain their original relative order), whereas standard Selection Sort is unstable.",
