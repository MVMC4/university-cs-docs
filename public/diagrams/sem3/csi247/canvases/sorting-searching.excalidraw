			"updated": 1783720203887,
			"locked": false,
			"text": "It blindly executes its O(N^2) comparisons even if the array is already perfectly sorted (Best\ncase time complexity remains O(N^2)). \nFurthermore, the standard implementation is an unstable sort, meaning identical elements might\nswap relative positions.",
			"rawText": "It blindly executes its O(N^2) comparisons even if the array is already perfectly sorted (Best case time complexity remains O(N^2)). \nFurthermore, the standard implementation is an unstable sort, meaning identical elements might swap relative positions.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "It blindly executes its O(N^2) comparisons even if the array is already perfectly sorted (Best case time complexity remains O(N^2)). \nFurthermore, the standard implementation is an unstable sort, meaning identical elements might swap relative positions.",
			"autoResize": false,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
