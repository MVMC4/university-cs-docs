			],
			"updated": 1783726812512,
			"link": null,
			"locked": false,
			"hasTextLink": false
		},
		{
			"id": "TAv7jUue",
			"type": "text",
			"x": 1537.1164792023874,
			"y": 2770.480795216539,
			"width": 1044.998779296875,
			"height": 125,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "dashed",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b51",
			"roundness": null,
			"seed": 1650973708,
			"version": 6765,
			"versionNonce": 1748548660,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1783726812512,
			"locked": false,
			"text": "When to Pick It: It is incredibly powerful for small datasets (under 50 elements) or datasets\nthat are \"almost sorted\" (where the time complexity drops closer to O(N)). \nIn real-world enterprise code, advanced algorithms like Java's Arrays.sort() (Timsort) actually\nswitch to Insertion Sort when the sub-arrays get small enough because it has almost zero\noverhead.",
			"rawText": "When to Pick It: It is incredibly powerful for small datasets (under 50 elements) or datasets that are \"almost sorted\" (where the time complexity drops closer to O(N)). \nIn real-world enterprise code, advanced algorithms like Java's Arrays.sort() (Timsort) actually switch to Insertion Sort when the sub-arrays get small enough because it has almost zero overhead.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": "SHKIenIXru4usbKsp-cBP",
			"originalText": "When to Pick It: It is incredibly powerful for small datasets (under 50 elements) or datasets that are \"almost sorted\" (where the time complexity drops closer to O(N)). \nIn real-world enterprise code, advanced algorithms like Java's Arrays.sort() (Timsort) actually switch to Insertion Sort when the sub-arrays get small enough because it has almost zero overhead.",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
		{
			"id": "UKbbWjN5",
			"type": "text",
			"x": 1534.116429259706,
			"y": 3042.893935971748,
			"width": 1065.4926288311299,
			"height": 75,
			"angle": 0,
			"strokeColor": "#e03131",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "dashed",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b52",
			"roundness": null,
			"seed": 61373068,
			"version": 7046,
			"versionNonce": 1642549516,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1783726812512,
			"locked": false,
			"text": "While highly optimized for small or nearly sorted arrays, it is still inherently an O(N^2)\nalgorithm. If you feed it a massively large, fully randomized array, or worse, a reverse-sorted\narray, the constant shifting of memory will cause it to severely bottleneck.",
			"rawText": "While highly optimized for small or nearly sorted arrays, it is still inherently an O(N^2) algorithm. If you feed it a massively large, fully randomized array, or worse, a reverse-sorted array, the constant shifting of memory will cause it to severely bottleneck.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "While highly optimized for small or nearly sorted arrays, it is still inherently an O(N^2) algorithm. If you feed it a massively large, fully randomized array, or worse, a reverse-sorted array, the constant shifting of memory will cause it to severely bottleneck.",
			"autoResize": false,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
		{
			"id": "LBN5V-whRJ7RSu4la70r7",
			"type": "rectangle",
			"x": 1533.11140791527,
			"y": 2919.842680169738,
			"width": 1057.3389126899574,
			"height": 111.67013720532077,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
