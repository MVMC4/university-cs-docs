		},
		{
			"id": "AupVItvJ",
			"type": "text",
			"x": -704.6009837567966,
			"y": 566.6216879742052,
			"width": 1066.9986572265625,
			"height": 100,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "#e7f5ff",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "dashed",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b3R",
			"roundness": null,
			"seed": 1466135860,
			"version": 1027,
			"versionNonce": 384485260,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1783717458498,
			"locked": false,
			"text": "Imagine holding a hand of numbered cards. You only ever look at two neighboring cards at a time.\nIf the left card is bigger than the right, you swap them in your hand. \nYou keep sweeping left-to-right through the cards until you can make a full pass without swapping\nanything.",
			"rawText": "Imagine holding a hand of numbered cards. You only ever look at two neighboring cards at a time. If the left card is bigger than the right, you swap them in your hand. \nYou keep sweeping left-to-right through the cards until you can make a full pass without swapping anything.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": "pFMp84dkrC1SJ8bs7hZ7M",
			"originalText": "Imagine holding a hand of numbered cards. You only ever look at two neighboring cards at a time. If the left card is bigger than the right, you swap them in your hand. \nYou keep sweeping left-to-right through the cards until you can make a full pass without swapping anything.",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
