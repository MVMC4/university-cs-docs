		{
			"id": "NvOdqQRx",
			"type": "text",
			"x": -1832.1849056505098,
			"y": 4918.490447281444,
			"width": 967.998779296875,
			"height": 100,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "dashed",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
