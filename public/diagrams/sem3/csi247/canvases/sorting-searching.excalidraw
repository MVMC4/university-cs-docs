		{
			"id": "pT103VYc",
			"type": "text",
			"x": 413.0313631266599,
			"y": 3211.5005092281626,
			"width": 978.9986572265625,
			"height": 100,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "dashed",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b4O",
			"roundness": null,
			"seed": 1589014156,
			"version": 5804,
			"versionNonce": 920325388,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1783720191716,
			"locked": false,
			"text": "Why Pick It Over Bubble Sort : \nSelection sort guarantees exactly O(N) total swaps across the entire algorithm. \nBubble sort requires up to O(N^2) swaps. Even though both have an O(N^2) time complexity,\nSelection Sort is significantly more efficient regarding memory writes.",
			"rawText": "Why Pick It Over Bubble Sort : \nSelection sort guarantees exactly O(N) total swaps across the entire algorithm. \nBubble sort requires up to O(N^2) swaps. Even though both have an O(N^2) time complexity, Selection Sort is significantly more efficient regarding memory writes.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": "5kXAfkJ4d0jn9bpzyt7sO",
			"originalText": "Why Pick It Over Bubble Sort : \nSelection sort guarantees exactly O(N) total swaps across the entire algorithm. \nBubble sort requires up to O(N^2) swaps. Even though both have an O(N^2) time complexity, Selection Sort is significantly more efficient regarding memory writes.",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
