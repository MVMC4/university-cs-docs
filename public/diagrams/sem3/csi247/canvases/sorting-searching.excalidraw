		{
			"id": "mWkOjfLI",
			"type": "text",
			"x": -1831.1250792545288,
			"y": 2201.701560060647,
			"width": 1011.9987182617188,
			"height": 125,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "#e7f5ff",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "dashed",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b2p",
			"roundness": null,
			"seed": 1225342014,
			"version": 559,
			"versionNonce": 1424269580,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1783713289978,
			"locked": false,
			"text": "Imagine looking for \"Mooketsi\" in a massive, alphabetized university directory. \nInstead of reading page 1, then page 2 (Linear), you open the book exactly to the middle. \nIf you land on \"Vincent\", you know \"Mooketsi\" comes earlier. \nYou instantly tear the book in half, throw away the back half, and repeat the process on the\nremaining pages until you find the name.",
			"rawText": "Imagine looking for \"Mooketsi\" in a massive, alphabetized university directory. \nInstead of reading page 1, then page 2 (Linear), you open the book exactly to the middle. \nIf you land on \"Vincent\", you know \"Mooketsi\" comes earlier. \nYou instantly tear the book in half, throw away the back half, and repeat the process on the remaining pages until you find the name.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": "s_BKSMGsNw0rXTrKhvCzC",
			"originalText": "Imagine looking for \"Mooketsi\" in a massive, alphabetized university directory. \nInstead of reading page 1, then page 2 (Linear), you open the book exactly to the middle. \nIf you land on \"Vincent\", you know \"Mooketsi\" comes earlier. \nYou instantly tear the book in half, throw away the back half, and repeat the process on the remaining pages until you find the name.",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
