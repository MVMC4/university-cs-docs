		},
		{
			"id": "bZwPO7XQ",
			"type": "text",
			"x": 2663.8831163244754,
			"y": 528.0695760361821,
			"width": 1055.998779296875,
			"height": 150,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "#e7f5ff",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "dashed",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b5o",
			"roundness": null,
			"seed": 1221152820,
			"version": 1949,
			"versionNonce": 220166540,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1783726046045,
			"locked": false,
			"text": "Imagine sorting a massive stack of exams. You split the stack in half and give half to a friend.\nYou both split your stacks again, handing them out until everyone in the room is holding exactly\none exam. Since one exam is technically \"sorted,\" you all start pairing up. You compare your one\nexam with your partner's, placing the lower grade on top. You then take your sorted pile of two\nto another pair, merging them into a sorted pile of four, repeating this until the massive stack\nis reassembled perfectly in order.",
			"rawText": "Imagine sorting a massive stack of exams. You split the stack in half and give half to a friend. You both split your stacks again, handing them out until everyone in the room is holding exactly one exam. Since one exam is technically \"sorted,\" you all start pairing up. You compare your one exam with your partner's, placing the lower grade on top. You then take your sorted pile of two to another pair, merging them into a sorted pile of four, repeating this until the massive stack is reassembled perfectly in order.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": "-PEKxfdPxMssnTAXjdNVS",
			"originalText": "Imagine sorting a massive stack of exams. You split the stack in half and give half to a friend. You both split your stacks again, handing them out until everyone in the room is holding exactly one exam. Since one exam is technically \"sorted,\" you all start pairing up. You compare your one exam with your partner's, placing the lower grade on top. You then take your sorted pile of two to another pair, merging them into a sorted pile of four, repeating this until the massive stack is reassembled perfectly in order.",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
		{
			"id": "HBfJcWAq",
