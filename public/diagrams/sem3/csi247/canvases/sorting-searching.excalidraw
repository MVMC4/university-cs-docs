		{
			"id": "KsUnqMuo",
			"type": "text",
			"x": 416.4883755213591,
			"y": 764.5736279880848,
			"width": 1033.9986572265625,
			"height": 100,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "#e7f5ff",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "dashed",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b4W",
			"roundness": null,
			"seed": 1370890892,
			"version": 1623,
			"versionNonce": 1204747276,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1783719825021,
			"locked": false,
			"text": "Imagine looking at an unsorted lineup of students. You scan the entire line, find the absolute\nshortest student, and ask them to step to the front. You then ignore that student and scan the\nremaining line for the next shortest, placing them second. You repeat this until everyone is\nordered.",
			"rawText": "Imagine looking at an unsorted lineup of students. You scan the entire line, find the absolute shortest student, and ask them to step to the front. You then ignore that student and scan the remaining line for the next shortest, placing them second. You repeat this until everyone is ordered.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": "ftG4wd3AhuiJsu6E3sUjE",
			"originalText": "Imagine looking at an unsorted lineup of students. You scan the entire line, find the absolute shortest student, and ask them to step to the front. You then ignore that student and scan the remaining line for the next shortest, placing them second. You repeat this until everyone is ordered.",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
