		{
			"id": "_S31RJowtMZpEMRDELKlJ",
			"type": "rectangle",
			"x": 2656.8622632150814,
			"y": 267.88014534507533,
			"width": 1068.5427527249465,
			"height": 235,
			"angle": 0,
			"strokeColor": "#1e1e1e",
