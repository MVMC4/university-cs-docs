			"seed": 1539502631,
			"version": 2649,
			"versionNonce": 1819588258,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1783686329529,
			"locked": false,
			"text": "When to pick it\n- When dealing with small collections.\n- When handling unsorted data and you only need to search once.",
			"rawText": "When to pick it\n- When dealing with small collections.\n- When handling unsorted data and you only need to search once.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": "f0JHIH4D",
			"originalText": "When to pick it\n- When dealing with small collections.\n- When handling unsorted data and you only need to search once.",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
		{
			"id": "Ypj3kPeX",
			"type": "text",
			"x": -1837.55716432125,
			"y": 1508.8474839614394,
