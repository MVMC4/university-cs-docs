		{
			"id": "SHKIenIXru4usbKsp-cBP",
			"type": "rectangle",
			"x": 1532.1164792023874,
			"y": 2765.480795216539,
			"width": 1055.0235022048491,
			"height": 135,
			"angle": 0,
			"strokeColor": "#1e1e1e",
