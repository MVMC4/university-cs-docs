		{
			"id": "BaawZTh4",
			"type": "text",
			"x": 417.2733789202366,
			"y": 568.2818075775608,
			"width": 1022.9987182617188,
			"height": 175,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "dashed",
