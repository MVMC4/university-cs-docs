			"index": "b1QV",
			"roundness": null,
			"seed": 2116878185,
			"version": 2643,
			"versionNonce": 1201383806,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1783686348809,
			"locked": false,
			"text": "Why pick it over Binary Search? \n- You must use Linear Search if the data is unsorted and you only need to search once. \n- Sorting the data first just to use Binary Search would take O(nlogn) time, which is\nslower than just doing a Linear Search O(n).",
			"rawText": "Why pick it over Binary Search? \n- You must use Linear Search if the data is unsorted and you only need to search once. \n- Sorting the data first just to use Binary Search would take O(nlogn) time, which is slower than just doing a Linear Search O(n).",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": "jxvuo6kC",
			"originalText": "Why pick it over Binary Search? \n- You must use Linear Search if the data is unsorted and you only need to search once. \n- Sorting the data first just to use Binary Search would take O(nlogn) time, which is slower than just doing a Linear Search O(n).",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
