			"index": "b2g",
			"roundness": null,
			"seed": 1994639870,
			"version": 5060,
			"versionNonce": 1852158644,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1783717413623,
			"locked": false,
			"text": "Why Pick It Over Linear Search \nThe speed difference is astronomical for large datasets. Searching an array of 1,000,000\nelements linearly takes up to 1,000,000 comparisons. Binary search takes a maximum of 20\ncomparisons",
			"rawText": "Why Pick It Over Linear Search \nThe speed difference is astronomical for large datasets. Searching an array of 1,000,000 elements linearly takes up to 1,000,000 comparisons. Binary search takes a maximum of 20 comparisons",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": "S4296LJbCgZVxdgVRzpJD",
			"originalText": "Why Pick It Over Linear Search \nThe speed difference is astronomical for large datasets. Searching an array of 1,000,000 elements linearly takes up to 1,000,000 comparisons. Binary search takes a maximum of 20 comparisons",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
