			"boundElements": [],
			"updated": 1783726082558,
			"locked": false,
			"text": "A stable, in-place algorithm that builds the final sorted array one item at a time by picking\nthe next unsorted element and continuously shifting larger elements to the right to make room\nfor it.",
			"rawText": "A stable, in-place algorithm that builds the final sorted array one item at a time by picking the next unsorted element and continuously shifting larger elements to the right to make room for it.",
			"fontSize": 20,
