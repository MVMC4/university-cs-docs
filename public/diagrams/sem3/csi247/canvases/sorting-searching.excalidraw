			"updated": 1783726812512,
			"link": null,
			"locked": false,
			"hasTextLink": false
		},
		{
			"id": "CQvC7InI",
			"type": "text",
			"x": 1538.11140791527,
			"y": 2924.842680169738,
			"width": 1044.998779296875,
			"height": 100,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "dashed",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b54",
			"roundness": null,
			"seed": 2078033804,
			"version": 6727,
			"versionNonce": 762400652,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1783726812512,
			"locked": false,
			"text": "Why Pick It Over Bubble/Selection Sort: \nIt is strictly faster than Bubble Sort because it stops scanning early as soon as it finds the\ncorrect insertion point, whereas Bubble Sort blindly sweeps the entire unsorted boundary. It is\nalso a stable sort, unlike Selection Sort.",
			"rawText": "Why Pick It Over Bubble/Selection Sort: \nIt is strictly faster than Bubble Sort because it stops scanning early as soon as it finds the correct insertion point, whereas Bubble Sort blindly sweeps the entire unsorted boundary. It is also a stable sort, unlike Selection Sort.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": "LBN5V-whRJ7RSu4la70r7",
			"originalText": "Why Pick It Over Bubble/Selection Sort: \nIt is strictly faster than Bubble Sort because it stops scanning early as soon as it finds the correct insertion point, whereas Bubble Sort blindly sweeps the entire unsorted boundary. It is also a stable sort, unlike Selection Sort.",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
