			"verticalAlign": "top",
			"containerId": "_9AOrJzHXpFOh0Hwnfc4x",
			"originalText": "When to Pick It: \n- Only in strict educational environments, or when detecting if a dataset is already completely sorted (due to its O(N) best-case optimization).",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
		{
			"id": "B98MJ1DL",
			"type": "text",
			"x": -707.4764780545322,
			"y": 3914.2317357229654,
			"width": 1065.4926288311299,
			"height": 50,
			"angle": 0,
			"strokeColor": "#e03131",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "dashed",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b3E",
			"roundness": null,
			"seed": 246249908,
			"version": 4517,
			"versionNonce": 959702924,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1783717543123,
			"locked": false,
			"text": "Incredibly slow for large datasets. It performs up to O(N^2) memory write operations (swaps),\nwhich makes it a terrible choice for systems where writing to memory is expensive or slow.",
			"rawText": "Incredibly slow for large datasets. It performs up to O(N^2) memory write operations (swaps), which makes it a terrible choice for systems where writing to memory is expensive or slow.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Incredibly slow for large datasets. It performs up to O(N^2) memory write operations (swaps), which makes it a terrible choice for systems where writing to memory is expensive or slow.",
			"autoResize": false,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
