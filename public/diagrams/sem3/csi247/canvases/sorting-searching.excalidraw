		{
			"id": "KsZO7pP4",
			"type": "text",
			"x": 2660.332544302624,
			"y": 3695.728403347289,
			"width": 1033.998779296875,
			"height": 100,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "dashed",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b5i",
			"roundness": null,
			"seed": 1368606516,
			"version": 6589,
			"versionNonce": 1619251852,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1783726046045,
			"locked": false,
			"text": "Why Pick It Over Quick Sort: \nMerge Sort is a stable sort. If you have a list of university students sorted by Name, and you\nrun a Merge Sort to sort them by GPA, students with the exact same GPA will remain\nalphabetically sorted. Quick Sort would scramble their names.",
			"rawText": "Why Pick It Over Quick Sort: \nMerge Sort is a stable sort. If you have a list of university students sorted by Name, and you run a Merge Sort to sort them by GPA, students with the exact same GPA will remain alphabetically sorted. Quick Sort would scramble their names.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": "dEvxvgUDqOqE557tSZBgX",
			"originalText": "Why Pick It Over Quick Sort: \nMerge Sort is a stable sort. If you have a list of university students sorted by Name, and you run a Merge Sort to sort them by GPA, students with the exact same GPA will remain alphabetically sorted. Quick Sort would scramble their names.",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
