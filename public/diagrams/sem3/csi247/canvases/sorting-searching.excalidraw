		{
			"id": "UMTbKkKH",
			"type": "text",
			"x": -1835.489643956675,
			"y": 1393.8231315246255,
			"width": 956.9987182617188,
			"height": 100,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 1,
