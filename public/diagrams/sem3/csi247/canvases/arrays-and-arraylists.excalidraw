			"updated": 1783504180179,
			"locked": false,
			"text": "An Array is the most fundamental data structure in computer science. \nIt is a rigidly defined, static container that holds a fixed number of values of a single,\nuniform data type.",
			"rawText": "An Array is the most fundamental data structure in computer science. \nIt is a rigidly defined, static container that holds a fixed number of values of a single, uniform data type.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "An Array is the most fundamental data structure in computer science. \nIt is a rigidly defined, static container that holds a fixed number of values of a single, uniform data type.",
			"autoResize": false,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
