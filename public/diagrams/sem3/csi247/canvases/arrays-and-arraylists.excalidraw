		{
			"id": "9XIn84l3",
			"type": "text",
			"x": -4120.142890590351,
			"y": -1604.3164433242812,
			"width": 945.998779296875,
			"height": 175,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "dashed",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "av",
			"roundness": null,
			"seed": 1541273449,
			"version": 435,
			"versionNonce": 897837223,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1783505298144,
			"locked": false,
			"text": "Lightning Fast Access: Querying or updating data at a known index takes O(1) constant\ntime.(O(1) Random access)\nCache Locality: Because elements are physically next to each other in RAM, modern CPU\ncaches can load entire chunks of the array at once, making sequential processing\nincredibly fast.\nZero Space Waste (Static Arrays): They only take exactly the memory they need, with no\nextra nodes or pointers to track (unlike Linked Lists).",
			"rawText": "Lightning Fast Access: Querying or updating data at a known index takes O(1) constant time.(O(1) Random access)\nCache Locality: Because elements are physically next to each other in RAM, modern CPU caches can load entire chunks of the array at once, making sequential processing incredibly fast.\nZero Space Waste (Static Arrays): They only take exactly the memory they need, with no extra nodes or pointers to track (unlike Linked Lists).",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": "gf5VFW22pOt1ajfFjN3bN",
			"originalText": "Lightning Fast Access: Querying or updating data at a known index takes O(1) constant time.(O(1) Random access)\nCache Locality: Because elements are physically next to each other in RAM, modern CPU caches can load entire chunks of the array at once, making sequential processing incredibly fast.\nZero Space Waste (Static Arrays): They only take exactly the memory they need, with no extra nodes or pointers to track (unlike Linked Lists).",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
