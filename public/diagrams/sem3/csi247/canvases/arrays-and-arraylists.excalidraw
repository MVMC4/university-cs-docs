			"boundElements": [],
			"updated": 1783504516031,
			"locked": false,
			"text": "Core Properties\nHomogeneous: Every element inside the collection must be of the exact same data type\n(e.g., all int or all String).\nContiguous: Elements are stored strictly side-by-side in memory with zero gaps.\nZero-Indexed: The first element is always located at position 0, representing the\n\"offset\" from the start of the array.\nDimensionality: Can be one-dimensional (a list) or multi-dimensional (matrices, like a\nchessboard).",
			"rawText": "Core Properties\nHomogeneous: Every element inside the collection must be of the exact same data type (e.g., all int or all String).\nContiguous: Elements are stored strictly side-by-side in memory with zero gaps.\nZero-Indexed: The first element is always located at position 0, representing the \"offset\" from the start of the array.\nDimensionality: Can be one-dimensional (a list) or multi-dimensional (matrices, like a chessboard).",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": "mns0I2tA",
			"originalText": "Core Properties\nHomogeneous: Every element inside the collection must be of the exact same data type (e.g., all int or all String).\nContiguous: Elements are stored strictly side-by-side in memory with zero gaps.\nZero-Indexed: The first element is always located at position 0, representing the \"offset\" from the start of the array.\nDimensionality: Can be one-dimensional (a list) or multi-dimensional (matrices, like a chessboard).",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
