			"versionNonce": 1844326695,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1783504209169,
			"locked": false,
			"text": "An ArrayList (or Dynamic Array) is an intelligent software wrapper built on top of a\nstandard Array. It provides the illusion of infinite space by automatically managing a\nhidden internal array, resizing itself geometrically whenever it runs out of capacity.",
			"rawText": "An ArrayList (or Dynamic Array) is an intelligent software wrapper built on top of a standard Array. It provides the illusion of infinite space by automatically managing a hidden internal array, resizing itself geometrically whenever it runs out of capacity.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "An ArrayList (or Dynamic Array) is an intelligent software wrapper built on top of a standard Array. It provides the illusion of infinite space by automatically managing a hidden internal array, resizing itself geometrically whenever it runs out of capacity.",
			"autoResize": false,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
