			"updated": 1783511919123,
			"locked": false,
			"text": "The absolute most important rule in Java collections: Arrays can hold anything. \nArrayLists can ONLY hold Objects.",
			"rawText": "The absolute most important rule in Java collections: Arrays can hold anything. \nArrayLists can ONLY hold Objects.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "The absolute most important rule in Java collections: Arrays can hold anything. \nArrayLists can ONLY hold Objects.",
