			"version": 270,
			"versionNonce": 864609156,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1783510030060,
			"locked": false,
			"text": "Use an Array when you know the exact maximum size of your dataset in advance and need\nmaximum computational speed (e.g., processing pixels on a screen).\n\nUse an ArrayList when your data volume fluctuates and you prioritize developer\nconvenience and built-in methods over microscopic memory optimizations.",
			"rawText": "Use an Array when you know the exact maximum size of your dataset in advance and need maximum computational speed (e.g., processing pixels on a screen).\n\nUse an ArrayList when your data volume fluctuates and you prioritize developer convenience and built-in methods over microscopic memory optimizations.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": "oakdlL35KiHhLCsj7CkEp",
			"originalText": "Use an Array when you know the exact maximum size of your dataset in advance and need maximum computational speed (e.g., processing pixels on a screen).\n\nUse an ArrayList when your data volume fluctuates and you prioritize developer convenience and built-in methods over microscopic memory optimizations.",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
