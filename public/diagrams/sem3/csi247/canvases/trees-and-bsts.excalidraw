		{
			"id": "S5lGGvEk",
			"type": "text",
			"x": 5060.96883576202,
			"y": 573.5001044032434,
			"width": 857.9988403320312,
			"height": 150,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "dashed",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b5X",
			"roundness": null,
			"seed": 1817230980,
			"version": 1038,
			"versionNonce": 208399524,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1783559956313,
			"locked": false,
			"text": "Implementing a full Balanced Binary Tree—specifically an AVL Tree-is a massive\nstep up from a standard BST.\n  - To maintain the absolute O(log N) guarantee, the tree must proactively \n    monitor its own shape. \n - If it detects that one side is getting too heavy, it performs structural \n    Rotations to fix itself.",
			"rawText": "Implementing a full Balanced Binary Tree—specifically an AVL Tree-is a massive step up from a standard BST.\n  - To maintain the absolute O(log N) guarantee, the tree must proactively \n    monitor its own shape. \n - If it detects that one side is getting too heavy, it performs structural \n    Rotations to fix itself.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": "m1umPOaaKdtpnu68e9nwr",
			"originalText": "Implementing a full Balanced Binary Tree—specifically an AVL Tree-is a massive step up from a standard BST.\n  - To maintain the absolute O(log N) guarantee, the tree must proactively \n    monitor its own shape. \n - If it detects that one side is getting too heavy, it performs structural \n    Rotations to fix itself.",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
