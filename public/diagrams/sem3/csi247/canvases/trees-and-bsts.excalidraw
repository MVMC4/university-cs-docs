		{
			"id": "pMf1ACC6",
			"type": "text",
			"x": -402.191781003941,
			"y": 326.3605818770472,
			"width": 1035.507038176785,
			"height": 75,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
