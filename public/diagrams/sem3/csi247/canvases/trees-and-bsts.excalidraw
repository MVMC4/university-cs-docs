		{
			"id": "YY3gYR7n",
			"type": "text",
			"x": 2815.2973211458243,
			"y": 4201.313134658623,
			"width": 934.9989013671875,
			"height": 150,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
