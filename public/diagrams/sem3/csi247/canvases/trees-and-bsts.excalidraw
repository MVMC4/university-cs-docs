			"boundElements": [],
			"updated": 1783554828647,
			"locked": false,
			"text": "For every single node in the tree:\n  - Left Subtree: ALL values must be strictly less than the node's value.\n  - Right Subtree: ALL values must be strictly greater than the node's value.",
			"rawText": "For every single node in the tree:\n  - Left Subtree: ALL values must be strictly less than the node's value.\n  - Right Subtree: ALL values must be strictly greater than the node's value.",
