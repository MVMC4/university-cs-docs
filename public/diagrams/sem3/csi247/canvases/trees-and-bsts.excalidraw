			"updated": 1783545802171,
			"locked": false,
			"text": "The Mechanics of Deletion (The \"General\" Tree Problem)",
			"rawText": "The Mechanics of Deletion (The \"General\" Tree Problem)",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "The Mechanics of Deletion (The \"General\" Tree Problem)",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
		{
			"id": "wkZCqNUh",
			"type": "text",
			"x": 2802.544397106958,
			"y": 4456.4914325851405,
			"width": 1041.3255322205982,
			"height": 75,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "dashed",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b1l",
			"roundness": null,
			"seed": 1743591044,
			"version": 1081,
			"versionNonce": 1187052420,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1783545802171,
			"locked": false,
			"text": "Deleting in a General Tree is tricky because deleting a node that is an internal node (not a\nleaf) forces a decision: What happens to its children? In a standard General Tree, if you\ndelete a parent, you usually delete the entire subtree rooted at that parent.",
			"rawText": "Deleting in a General Tree is tricky because deleting a node that is an internal node (not a leaf) forces a decision: What happens to its children? In a standard General Tree, if you delete a parent, you usually delete the entire subtree rooted at that parent.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Deleting in a General Tree is tricky because deleting a node that is an internal node (not a leaf) forces a decision: What happens to its children? In a standard General Tree, if you delete a parent, you usually delete the entire subtree rooted at that parent.",
			"autoResize": false,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
