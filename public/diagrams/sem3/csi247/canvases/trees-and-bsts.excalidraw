			"isDeleted": false,
			"boundElements": [],
			"updated": 1783534691642,
			"locked": false,
			"text": "In a tree, data is organized across multiple levels.\nFrom any given node, there are multiple diverging paths you can take to traverse the structure.",
			"rawText": "In a tree, data is organized across multiple levels.\nFrom any given node, there are multiple diverging paths you can take to traverse the structure.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "In a tree, data is organized across multiple levels.\nFrom any given node, there are multiple diverging paths you can take to traverse the structure.",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
