		{
			"id": "IxAlWx0Z",
			"type": "text",
			"x": 3884.793021507803,
			"y": 941.9375258144664,
			"width": 1031.0033850683367,
			"height": 75,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "dashed",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b3x",
			"roundness": null,
			"seed": 872915388,
			"version": 488,
			"versionNonce": 271679292,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1783554828647,
			"locked": false,
			"text": "By enforcing this rule, a BST acts like a dynamic, sorted array. \nWhen searching for a value, every comparison allows you to eliminate 50% of the remaining\ntree (just like Binary Search).",
			"rawText": "By enforcing this rule, a BST acts like a dynamic, sorted array. \nWhen searching for a value, every comparison allows you to eliminate 50% of the remaining tree (just like Binary Search).",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "By enforcing this rule, a BST acts like a dynamic, sorted array. \nWhen searching for a value, every comparison allows you to eliminate 50% of the remaining tree (just like Binary Search).",
			"autoResize": false,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
		{
			"id": "f390ovfe",
			"type": "rectangle",
			"x": 3894.3448898779675,
			"y": 1433.2830026634474,
			"width": 998.7066339847878,
			"height": 160,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "#fff9db",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "dashed",
			"roughness": 0,
			"opacity": 100,
