		{
			"id": "YY1RX3OS",
			"type": "text",
			"x": 2813.259104950559,
			"y": 1799.703370095362,
			"width": 967.9989013671875,
			"height": 125,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "#fff9db",
