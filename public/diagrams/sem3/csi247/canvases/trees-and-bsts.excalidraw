		{
			"id": "ZDaWPiSA",
			"type": "text",
			"x": 2811.381904215394,
			"y": 4851.815038451628,
			"width": 989.9986572265625,
			"height": 150,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "dashed",
			"roughness": 0,
