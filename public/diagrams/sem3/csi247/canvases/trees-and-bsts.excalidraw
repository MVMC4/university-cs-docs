			"versionNonce": 698757308,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1783545802171,
			"locked": false,
			"text": "Time Complexity: O(N)\nSpace Complexity: O(H)\nExplanation: You visit every node exactly once. Space complexity is tied to the Height (H)\nof the tree due to the system call stack used during recursion.",
			"rawText": "Time Complexity: O(N)\nSpace Complexity: O(H)\nExplanation: You visit every node exactly once. Space complexity is tied to the Height (H) of the tree due to the system call stack used during recursion.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": "x1YzepNM",
			"originalText": "Time Complexity: O(N)\nSpace Complexity: O(H)\nExplanation: You visit every node exactly once. Space complexity is tied to the Height (H) of the tree due to the system call stack used during recursion.",
			"autoResize": true,
			"lineHeight": 1.25,
