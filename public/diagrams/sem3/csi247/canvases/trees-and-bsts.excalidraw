		{
			"id": "LwbkS7c9",
			"type": "text",
			"x": -400.4600115883993,
			"y": 1008.8559314953493,
			"width": 1022.998779296875,
			"height": 325,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "#fff9db",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "dashed",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b26",
			"roundness": null,
			"seed": 1588523324,
			"version": 113,
			"versionNonce": 1881835396,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1783544254415,
			"locked": false,
			"text": "Properties of Tree Data Structure:\n* Number of edges: An edge is the connection between two nodes. A tree with N nodes will \n  always have N - 1 edges. \n  There is exactly one path from any node to any other node in the tree.\n* Depth of a node: The depth of a node is the length of the path from the root to that node. \n  Each edge in the path adds 1 unit to the length. Equivalently, it is the number of edges \n  from the root to the node.\n* Height of the tree: The height of the tree is the length of the longest path from the root \n  to any leaf node.\n* Degree of a node: The degree of a node is the number of subtrees attached to it (i.e., the \n  number of children it has).\n  A leaf node has a degree of 0.\n  The degree of the tree is the maximum degree among all nodes in the tree.",
			"rawText": "Properties of Tree Data Structure:\n* Number of edges: An edge is the connection between two nodes. A tree with N nodes will \n  always have N - 1 edges. \n  There is exactly one path from any node to any other node in the tree.\n* Depth of a node: The depth of a node is the length of the path from the root to that node. \n  Each edge in the path adds 1 unit to the length. Equivalently, it is the number of edges \n  from the root to the node.\n* Height of the tree: The height of the tree is the length of the longest path from the root \n  to any leaf node.\n* Degree of a node: The degree of a node is the number of subtrees attached to it (i.e., the \n  number of children it has).\n  A leaf node has a degree of 0.\n  The degree of the tree is the maximum degree among all nodes in the tree.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": "CjlxKYmy",
			"originalText": "Properties of Tree Data Structure:\n* Number of edges: An edge is the connection between two nodes. A tree with N nodes will \n  always have N - 1 edges. \n  There is exactly one path from any node to any other node in the tree.\n* Depth of a node: The depth of a node is the length of the path from the root to that node. \n  Each edge in the path adds 1 unit to the length. Equivalently, it is the number of edges \n  from the root to the node.\n* Height of the tree: The height of the tree is the length of the longest path from the root \n  to any leaf node.\n* Degree of a node: The degree of a node is the number of subtrees attached to it (i.e., the \n  number of children it has).\n  A leaf node has a degree of 0.\n  The degree of the tree is the maximum degree among all nodes in the tree.",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
