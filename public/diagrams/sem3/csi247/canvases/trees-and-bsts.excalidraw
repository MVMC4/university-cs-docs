			"boundElements": [],
			"updated": 1783535543350,
			"locked": false,
			"text": "* Level/Depth of a Node: The number of edges in the path from the root to that node.\n  The root node is at level 0.\n* Height of Tree: Maximum depth among all nodes (number of edges on the longest path \n  from root to leaf).",
			"rawText": "* Level/Depth of a Node: The number of edges in the path from the root to that node.\n  The root node is at level 0.\n* Height of Tree: Maximum depth among all nodes (number of edges on the longest path \n  from root to leaf).",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "* Level/Depth of a Node: The number of edges in the path from the root to that node.\n  The root node is at level 0.\n* Height of Tree: Maximum depth among all nodes (number of edges on the longest path \n  from root to leaf).",
			"autoResize": false,
			"lineHeight": 1.25,
