			"version": 518,
			"versionNonce": 1408767268,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1783559956313,
			"locked": false,
			"text": "If you insert data that is already sorted into a standard BST (e.g., insert(1), insert(2),\ninsert(3), insert(4)), it just keeps placing them to the right. The tree degrades into a\nstraight line (a Linked List).When this happens, the Height (H) becomes equal to N.\nYour fast O(log N) searches and inserts silently degrade into O(N) operations!",
			"rawText": "If you insert data that is already sorted into a standard BST (e.g., insert(1), insert(2), insert(3), insert(4)), it just keeps placing them to the right. The tree degrades into a straight line (a Linked List).When this happens, the Height (H) becomes equal to N.\nYour fast O(log N) searches and inserts silently degrade into O(N) operations!",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "If you insert data that is already sorted into a standard BST (e.g., insert(1), insert(2), insert(3), insert(4)), it just keeps placing them to the right. The tree degrades into a straight line (a Linked List).When this happens, the Height (H) becomes equal to N.\nYour fast O(log N) searches and inserts silently degrade into O(N) operations!",
			"autoResize": false,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
