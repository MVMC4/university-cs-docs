			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Since there is no order in a General Tree (unlike a BST), we have no way to \"skip\" branches. We must search recursively: check the current node, then check every child.",
			"autoResize": false,
			"lineHeight": 1.25,
			"hasTextLink": false,
