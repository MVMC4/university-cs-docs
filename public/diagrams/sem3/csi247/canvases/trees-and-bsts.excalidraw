		{
			"id": "oOMZGaxx",
			"type": "text",
			"x": 2812.767832576492,
			"y": 5025.689161636954,
			"width": 923.998779296875,
			"height": 125,
			"angle": 0,
			"strokeColor": "#1e1e1e",
