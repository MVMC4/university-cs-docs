			"groupIds": [],
			"frameId": null,
			"index": "b1pV",
			"roundness": null,
			"seed": 1992395836,
			"version": 742,
			"versionNonce": 848151812,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1783546226526,
			"locked": false,
			"text": "The Logic\n* Case 1 (Leaf Node): Simple. Remove the reference from the parent's children list. \n  O(N) because you must first find the parent (which requires an O(N) search).\n* Case 2 (Internal Node): Complex. If you delete node X, you must decide if you are \n  deleting the whole subtree (easy) or promoting one of the children to take the parent's \n  place (very hard—usually avoided in General Trees).",
			"rawText": "The Logic\n* Case 1 (Leaf Node): Simple. Remove the reference from the parent's children list. \n  O(N) because you must first find the parent (which requires an O(N) search).\n* Case 2 (Internal Node): Complex. If you delete node X, you must decide if you are \n  deleting the whole subtree (easy) or promoting one of the children to take the parent's \n  place (very hard—usually avoided in General Trees).",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": "Wr2kPd8A",
			"originalText": "The Logic\n* Case 1 (Leaf Node): Simple. Remove the reference from the parent's children list. \n  O(N) because you must first find the parent (which requires an O(N) search).\n* Case 2 (Internal Node): Complex. If you delete node X, you must decide if you are \n  deleting the whole subtree (easy) or promoting one of the children to take the parent's \n  place (very hard—usually avoided in General Trees).",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
