		{
			"id": "XWWmGzSo",
			"type": "text",
			"x": 3882.832421710955,
			"y": 3621.337188351553,
			"width": 1022.9988403320312,
			"height": 75,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "dashed",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b4d",
			"roundness": null,
			"seed": 492802308,
			"version": 339,
			"versionNonce": 1679338372,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1783554828647,
			"locked": false,
			"text": "Explanation: To traverse the tree, you must visit every node, making it strictly linear time.\nIn a BST, In-Order Traversal is the most important because it visits the left (smaller), then\nroot, then right (larger)—which prints the tree in perfectly sorted order!",
			"rawText": "Explanation: To traverse the tree, you must visit every node, making it strictly linear time. In a BST, In-Order Traversal is the most important because it visits the left (smaller), then root, then right (larger)—which prints the tree in perfectly sorted order!",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": "M-ZxgRnTMaZ0J-PVpvGjU",
			"originalText": "Explanation: To traverse the tree, you must visit every node, making it strictly linear time. In a BST, In-Order Traversal is the most important because it visits the left (smaller), then root, then right (larger)—which prints the tree in perfectly sorted order!",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
