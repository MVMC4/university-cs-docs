		{
			"id": "Y8J5pyvK",
			"type": "text",
			"x": 4982.794350817227,
			"y": 288.91089125873816,
			"width": 991.7913928232606,
			"height": 225,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "dashed",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b5S",
			"roundness": null,
			"seed": 842129668,
			"version": 1304,
			"versionNonce": 1078435748,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1783560109304,
			"locked": false,
			"text": "A Balanced Binary Tree contains an algorithm that tracks the height of the left and right\nsubtrees. \nIf the tree becomes \"heavy\" on one side (the height difference is > 1), it triggers a\nRotation.\n  - Purpose: To strictly guarantee that the tree's height H always equals log N.\n  - Complexity: Search, Insert, and Delete are absolutely mathematically guaranteed to be \n    O(log N) worst-case time. Space remains O(log N).\n  - Real-World Usage: Java's TreeMap and TreeSet, and most database indexing engines use \n    Red-Black trees because they cannot afford the risk of O(N) degradation.",
			"rawText": "A Balanced Binary Tree contains an algorithm that tracks the height of the left and right subtrees. \nIf the tree becomes \"heavy\" on one side (the height difference is > 1), it triggers a Rotation.\n  - Purpose: To strictly guarantee that the tree's height H always equals log N.\n  - Complexity: Search, Insert, and Delete are absolutely mathematically guaranteed to be \n    O(log N) worst-case time. Space remains O(log N).\n  - Real-World Usage: Java's TreeMap and TreeSet, and most database indexing engines use \n    Red-Black trees because they cannot afford the risk of O(N) degradation.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "A Balanced Binary Tree contains an algorithm that tracks the height of the left and right subtrees. \nIf the tree becomes \"heavy\" on one side (the height difference is > 1), it triggers a Rotation.\n  - Purpose: To strictly guarantee that the tree's height H always equals log N.\n  - Complexity: Search, Insert, and Delete are absolutely mathematically guaranteed to be \n    O(log N) worst-case time. Space remains O(log N).\n  - Real-World Usage: Java's TreeMap and TreeSet, and most database indexing engines use \n    Red-Black trees because they cannot afford the risk of O(N) degradation.",
			"autoResize": false,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
