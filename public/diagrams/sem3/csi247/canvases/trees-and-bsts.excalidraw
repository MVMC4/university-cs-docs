		{
			"id": "mPjm2hrI",
			"type": "text",
			"x": 3899.3448898779675,
			"y": 1438.2830026634474,
			"width": 978.9987182617188,
			"height": 150,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "#fff9db",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "dashed",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b40",
			"roundness": null,
			"seed": 748412292,
			"version": 391,
			"versionNonce": 951465916,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1783554828647,
			"locked": false,
			"text": "Time Complexity: O(H) — Averages to O(log N) if balanced, degrades to O(N) if skewed into\na straight line.\nSpace Complexity: O(1) (Iterative) or O(H) (Recursive stack).\nExplanation: Because of the BST invariant, we don't have to check every node. \nIf the target is smaller than the current node, we go left. If it's larger, we go right.\nWe follow a single path from root to leaf.",
			"rawText": "Time Complexity: O(H) — Averages to O(log N) if balanced, degrades to O(N) if skewed into a straight line.\nSpace Complexity: O(1) (Iterative) or O(H) (Recursive stack).\nExplanation: Because of the BST invariant, we don't have to check every node. \nIf the target is smaller than the current node, we go left. If it's larger, we go right. We follow a single path from root to leaf.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": "f390ovfe",
			"originalText": "Time Complexity: O(H) — Averages to O(log N) if balanced, degrades to O(N) if skewed into a straight line.\nSpace Complexity: O(1) (Iterative) or O(H) (Recursive stack).\nExplanation: Because of the BST invariant, we don't have to check every node. \nIf the target is smaller than the current node, we go left. If it's larger, we go right. We follow a single path from root to leaf.",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
