			"isDeleted": false,
			"boundElements": [],
			"updated": 1783534691642,
			"locked": false,
			"text": "In a linear structure (like an Array), there is only one logical path to read the data: start\nto finish. \n",
			"rawText": "In a linear structure (like an Array), there is only one logical path to read the data: start to finish. \n",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "In a linear structure (like an Array), there is only one logical path to read the data: start to finish. \n",
			"autoResize": false,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
		{
