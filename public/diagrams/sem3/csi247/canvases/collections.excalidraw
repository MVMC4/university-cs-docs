			"boundElements": [],
			"updated": 1783684440767,
			"locked": false,
			"text": "Searching is the process of traversing a collection to look for a specific element.\nWe don't just search to \"find\" things; searching is the mandatory first step for\nseveral critical data operations:",
			"rawText": "Searching is the process of traversing a collection to look for a specific element. \nWe don't just search to \"find\" things; searching is the mandatory first step for several critical data operations:",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Searching is the process of traversing a collection to look for a specific element. \nWe don't just search to \"find\" things; searching is the mandatory first step for several critical data operations:",
			"autoResize": false,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
