			"updated": 1783684440767,
			"locked": false,
			"text": "- Finding: Checking whether a student with ID 202501234 is actually in the \n  class list.\n- Modifying: Locating the student with ID 202401723 so we can update their name\n  to \"Thomas Jones\".\n- Deleting / Displaying: Locating a specific student with ID 202509342 to \n  display their details or remove them from the system entirely.",
			"rawText": "- Finding: Checking whether a student with ID 202501234 is actually in the \n  class list.\n- Modifying: Locating the student with ID 202401723 so we can update their name \n  to \"Thomas Jones\".\n- Deleting / Displaying: Locating a specific student with ID 202509342 to \n  display their details or remove them from the system entirely.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": "DSQINAWpyDK9ZMzJgySEf",
			"originalText": "- Finding: Checking whether a student with ID 202501234 is actually in the \n  class list.\n- Modifying: Locating the student with ID 202401723 so we can update their name \n  to \"Thomas Jones\".\n- Deleting / Displaying: Locating a specific student with ID 202509342 to \n  display their details or remove them from the system entirely.",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
