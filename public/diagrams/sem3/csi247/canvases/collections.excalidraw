			"updated": 1783684440767,
			"locked": false,
			"text": "Imagine the 2026/27 CSI247 class list from ASAS. \nThis list of students is our collection. \nIn programming, a collection is simply a group of data items that we need to\nmanage, and searching is one of the most common tasks we perform on it.",
			"rawText": "Imagine the 2026/27 CSI247 class list from ASAS. \nThis list of students is our collection. \nIn programming, a collection is simply a group of data items that we need to manage, and searching is one of the most common tasks we perform on it.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Imagine the 2026/27 CSI247 class list from ASAS. \nThis list of students is our collection. \nIn programming, a collection is simply a group of data items that we need to manage, and searching is one of the most common tasks we perform on it.",
			"autoResize": false,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
