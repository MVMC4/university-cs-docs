			"seed": 624744622,
			"version": 28,
			"versionNonce": 1073589877,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1783350667405,
			"locked": false,
			"text": "\"Traversal\" (or Lookup) is a common computer science term. You might confuse it with\n\"Iteration\" (like a for loop). Iteration is a discrete loop that runs a fixed number of\ntimes. Because Linked Lists don't always have a tracked, fixed size and rely on pointer\nhopping, we use the term Traversal—moving from one node to the next until a condition is\nmet (like hitting null).",
			"rawText": "\"Traversal\" (or Lookup) is a common computer science term. You might confuse it with \"Iteration\" (like a for loop). Iteration is a discrete loop that runs a fixed number of times. Because Linked Lists don't always have a tracked, fixed size and rely on pointer hopping, we use the term Traversal—moving from one node to the next until a condition is met (like hitting null).",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": "98clHSwz",
			"originalText": "\"Traversal\" (or Lookup) is a common computer science term. You might confuse it with \"Iteration\" (like a for loop). Iteration is a discrete loop that runs a fixed number of times. Because Linked Lists don't always have a tracked, fixed size and rely on pointer hopping, we use the term Traversal—moving from one node to the next until a condition is met (like hitting null).",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
