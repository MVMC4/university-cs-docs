			"locked": false,
			"hasTextLink": false
		},
		{
			"id": "zZF53CUW",
			"type": "text",
			"x": 702.6215010782009,
			"y": 4238.907718109488,
			"width": 1187.9986572265625,
			"height": 75,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "#e7f5ff",
			"fillStyle": "solid",
			"strokeWidth": 0.5,
			"strokeStyle": "dashed",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b1Y",
			"roundness": null,
			"seed": 122737339,
			"version": 2005,
			"versionNonce": 381539797,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1783355544119,
			"locked": false,
			"text": "Time Complexity: O(1) — Constant time.\n - Explanation: We simply point our new node's next reference to the current head, and then declare the new \n   node as the new head. No shifting is required (unlike an Array).",
			"rawText": "Time Complexity: O(1) — Constant time.\n - Explanation: We simply point our new node's next reference to the current head, and then declare the new \n   node as the new head. No shifting is required (unlike an Array).",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": "I8GcSi1M9q0FPmNDGlssX",
			"originalText": "Time Complexity: O(1) — Constant time.\n - Explanation: We simply point our new node's next reference to the current head, and then declare the new \n   node as the new head. No shifting is required (unlike an Array).",
