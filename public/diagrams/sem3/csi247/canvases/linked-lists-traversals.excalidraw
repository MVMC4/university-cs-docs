		{
			"id": "UY6QD0HL",
			"type": "text",
			"x": -422.9111261131861,
			"y": 3537.1510377970226,
			"width": 934.9988403320312,
			"height": 125,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "dashed",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b13",
			"roundness": null,
			"seed": 608693298,
			"version": 209,
			"versionNonce": 740448855,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1783370361902,
			"locked": false,
			"text": "DO NOT use a Linked List when:\n1. You need to frequently search for elements or access items by an index.\n2. Memory efficiency and raw CPU iteration speed (cache locality) are top priorities.\n3. You are mostly just appending data to the end of a list and reading it later (an\nArrayList is vastly superior here).",
			"rawText": "DO NOT use a Linked List when:\n1. You need to frequently search for elements or access items by an index.\n2. Memory efficiency and raw CPU iteration speed (cache locality) are top priorities.\n3. You are mostly just appending data to the end of a list and reading it later (an ArrayList is vastly superior here).",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": "j0uPucu8mnJn1VfY3Ysb7",
			"originalText": "DO NOT use a Linked List when:\n1. You need to frequently search for elements or access items by an index.\n2. Memory efficiency and raw CPU iteration speed (cache locality) are top priorities.\n3. You are mostly just appending data to the end of a list and reading it later (an ArrayList is vastly superior here).",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
