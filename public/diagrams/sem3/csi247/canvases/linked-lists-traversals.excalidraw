			"versionNonce": 1689533813,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1783350667405,
			"locked": false,
			"text": "It is commonly used as the underlying building block for other complex data structures\nlike Queues, Stacks, Graphs, and Hash Tables (for collision resolution). \nMastering this structure is a critical stepping stone in your computer science journey.",
			"rawText": "It is commonly used as the underlying building block for other complex data structures like Queues, Stacks, Graphs, and Hash Tables (for collision resolution). \nMastering this structure is a critical stepping stone in your computer science journey.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": "UV4zSctZg464M90mgal_r",
			"originalText": "It is commonly used as the underlying building block for other complex data structures like Queues, Stacks, Graphs, and Hash Tables (for collision resolution). \nMastering this structure is a critical stepping stone in your computer science journey.",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
		{
			"id": "cLNEN0Wh",
			"type": "rectangle",
			"x": -416.6938265135837,
			"y": 1280.588204907824,
			"width": 983.8740808823533,
			"height": 210,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
