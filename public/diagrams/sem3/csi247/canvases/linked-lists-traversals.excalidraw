		{
			"id": "rXb58cFO",
			"type": "text",
			"x": 5763.614105322346,
			"y": 276.70613763893425,
			"width": 989.9987182617188,
			"height": 125,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "dashed",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b5pV",
			"roundness": null,
			"seed": 1503709716,
			"version": 49,
			"versionNonce": 282976300,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1783375955712,
			"locked": false,
			"text": "A linear traversal is the process of visiting every element within a linear data structure\nsequentially, from the structural origin to the terminal boundary, exactly once. \n\nIt is the foundational mechanism used to read, search, or mutate data collections where\nelements are arranged in a strict one-dimensional sequence.",
			"rawText": "A linear traversal is the process of visiting every element within a linear data structure sequentially, from the structural origin to the terminal boundary, exactly once. \n\nIt is the foundational mechanism used to read, search, or mutate data collections where elements are arranged in a strict one-dimensional sequence.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "middle",
			"containerId": "swcDghaP",
			"originalText": "A linear traversal is the process of visiting every element within a linear data structure sequentially, from the structural origin to the terminal boundary, exactly once. \n\nIt is the foundational mechanism used to read, search, or mutate data collections where elements are arranged in a strict one-dimensional sequence.",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
		{
			"id": "Gp2IKwHv",
			"type": "rectangle",
			"x": 5756.818596454586,
			"y": 450.9858924300611,
			"width": 1046.758941943262,
			"height": 493.48054021125284,
			"angle": 0,
			"strokeColor": "#1e1e1e",
