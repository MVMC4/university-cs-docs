			"seed": 183470711,
			"version": 75,
			"versionNonce": 1853804633,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1783366128058,
			"locked": false,
			"text": "Before you can calculate averages or find values, you have to know how to visit every node and log its contents. \nThis is the absolute blueprint for all aggregation operations.",
			"rawText": "Before you can calculate averages or find values, you have to know how to visit every node and log its contents. \nThis is the absolute blueprint for all aggregation operations.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Before you can calculate averages or find values, you have to know how to visit every node and log its contents. \nThis is the absolute blueprint for all aggregation operations.",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
