		},
		{
			"id": "Y8EFIiio",
			"type": "text",
			"x": 4668.911757314669,
			"y": 2550.4813250030697,
			"width": 1029.996741399918,
			"height": 75,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "#e3fafc",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b5B",
			"roundness": null,
			"seed": 264652793,
			"version": 455,
			"versionNonce": 1730227097,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1783373723971,
			"link": null,
			"locked": false,
			"text": "A Circular Linked List lacks an absolute termination boundary; it is never null-terminated.\nInstead of mapping the final node's forward reference to null, it cycles back to anchor into\nthe sequence origin.",
			"rawText": "A Circular Linked List lacks an absolute termination boundary; it is never null-terminated. Instead of mapping the final node's forward reference to null, it cycles back to anchor into the sequence origin.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "A Circular Linked List lacks an absolute termination boundary; it is never null-terminated. Instead of mapping the final node's forward reference to null, it cycles back to anchor into the sequence origin.",
			"autoResize": false,
			"lineHeight": 1.25,
			"hasTextLink": false
		},
