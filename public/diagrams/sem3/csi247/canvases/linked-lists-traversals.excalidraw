		{
			"id": "be7Kxyw4",
			"type": "text",
			"x": 4670.651180252155,
			"y": 327.86244278529415,
			"width": 953.0849609375002,
			"height": 75,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "#e3fafc",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "dashed",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b4z",
			"roundness": null,
			"seed": 655744567,
			"version": 203,
			"versionNonce": 928369143,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1783371972535,
			"link": null,
			"locked": false,
			"text": "A Doubly Linked List optimizes structural traversal by eliminating the unidirectional\nconstraint of a Singly Linked List. By adding a secondary reference pointer to each\nnode, the structure enables bidirectional navigation across the heap.",
			"rawText": "A Doubly Linked List optimizes structural traversal by eliminating the unidirectional constraint of a Singly Linked List. By adding a secondary reference pointer to each node, the structure enables bidirectional navigation across the heap.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "A Doubly Linked List optimizes structural traversal by eliminating the unidirectional constraint of a Singly Linked List. By adding a secondary reference pointer to each node, the structure enables bidirectional navigation across the heap.",
			"autoResize": false,
			"lineHeight": 1.25,
			"hasTextLink": false
		},
