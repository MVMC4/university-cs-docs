		{
			"id": "pUYcVHS6",
			"type": "text",
			"x": -421.9844663410861,
			"y": 3346.670231423627,
			"width": 901.9988403320312,
			"height": 150,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "dashed",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b10V",
			"roundness": null,
			"seed": 570845358,
			"version": 116,
			"versionNonce": 1340945431,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1783370361902,
			"locked": false,
			"text": "DO use a Linked List when:\n1. Your application requires constant, high-volume insertions and deletions at the\nabsolute beginning or end of the dataset.\n2. You are building a custom Stack, Queue, or specialized Deque.\n3. You have a highly unpredictable number of elements and cannot afford the\nunpredictable O(N) resizing penalty of an ArrayList.",
			"rawText": "DO use a Linked List when:\n1. Your application requires constant, high-volume insertions and deletions at the absolute beginning or end of the dataset.\n2. You are building a custom Stack, Queue, or specialized Deque.\n3. You have a highly unpredictable number of elements and cannot afford the unpredictable O(N) resizing penalty of an ArrayList.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": "m3ePMVXq",
			"originalText": "DO use a Linked List when:\n1. Your application requires constant, high-volume insertions and deletions at the absolute beginning or end of the dataset.\n2. You are building a custom Stack, Queue, or specialized Deque.\n3. You have a highly unpredictable number of elements and cannot afford the unpredictable O(N) resizing penalty of an ArrayList.",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
		{
			"id": "j0uPucu8mnJn1VfY3Ysb7",
			"type": "rectangle",
			"x": -427.9111261131861,
			"y": 3532.1510377970226,
			"width": 974.9906956130789,
			"height": 135,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
