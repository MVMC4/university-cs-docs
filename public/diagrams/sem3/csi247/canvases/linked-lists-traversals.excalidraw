			"isDeleted": false,
			"boundElements": [],
			"updated": 1783370867279,
			"link": null,
			"locked": false,
			"text": "To safely execute an in-place mutation, a rolling window of three\nreference variables must be maintained simultaneously.",
			"rawText": "To safely execute an in-place mutation, a rolling window of three reference variables must be maintained simultaneously.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "To safely execute an in-place mutation, a rolling window of three reference variables must be maintained simultaneously.",
			"autoResize": false,
			"lineHeight": 1.25,
			"hasTextLink": false
		},
