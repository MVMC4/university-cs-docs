		{
			"id": "4RGvZVOV",
			"type": "text",
			"x": 3362.5857623192055,
			"y": 920.1846539422646,
			"width": 1209.9984130859375,
			"height": 100,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "dashed",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
