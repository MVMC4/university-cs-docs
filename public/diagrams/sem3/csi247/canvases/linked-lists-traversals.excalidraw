		{
			"id": "Asx8jNQs",
			"type": "text",
			"x": 4672.719233915567,
			"y": 3618.7506732118372,
			"width": 978.998779296875,
			"height": 150,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "dashed",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b5KV",
			"roundness": null,
			"seed": 1941975961,
			"version": 829,
			"versionNonce": 1697193433,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1783373594185,
			"locked": false,
			"text": "Round-Robin CPU Scheduling: Operating system kernels leverage circular queues to allocate\nfixed execution time slices to processes in sequential rotation without encountering\nendpoint boundaries.\nContinuous Ring Buffers: Media streaming applications employ circular memory spaces to\nbuffer audio/video packets continuously, overwriting expired data frames automatically\nwithout structural reallocation.",
			"rawText": "Round-Robin CPU Scheduling: Operating system kernels leverage circular queues to allocate fixed execution time slices to processes in sequential rotation without encountering endpoint boundaries.\nContinuous Ring Buffers: Media streaming applications employ circular memory spaces to buffer audio/video packets continuously, overwriting expired data frames automatically without structural reallocation.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "bottom",
			"containerId": "0jXlv9WO",
			"originalText": "Round-Robin CPU Scheduling: Operating system kernels leverage circular queues to allocate fixed execution time slices to processes in sequential rotation without encountering endpoint boundaries.\nContinuous Ring Buffers: Media streaming applications employ circular memory spaces to buffer audio/video packets continuously, overwriting expired data frames automatically without structural reallocation.",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
