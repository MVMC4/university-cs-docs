			"roundness": null,
			"seed": 693589657,
			"version": 547,
			"versionNonce": 501894999,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1783373478818,
			"locked": false,
			"text": "In a Singly Linked List, deleting the tail requires an O(n) traversal to identify the\nsecond-to-last node. A Doubly Linked List resolves this bottleneck because the tail node\ndirectly references its predecessor via prev.",
			"rawText": "In a Singly Linked List, deleting the tail requires an O(n) traversal to identify the second-to-last node. A Doubly Linked List resolves this bottleneck because the tail node directly references its predecessor via prev.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "In a Singly Linked List, deleting the tail requires an O(n) traversal to identify the second-to-last node. A Doubly Linked List resolves this bottleneck because the tail node directly references its predecessor via prev.",
			"autoResize": false,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
