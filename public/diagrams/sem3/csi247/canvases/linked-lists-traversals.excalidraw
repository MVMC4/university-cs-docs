		},
		{
			"id": "ICQkgyVZ",
			"type": "text",
			"x": -415.4021671580352,
			"y": 2057.898049716819,
			"width": 879.9989013671875,
			"height": 100,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "dotted",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b0d",
			"roundness": null,
			"seed": 1586923886,
			"version": 144,
			"versionNonce": 9056405,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1783350667405,
			"locked": false,
			"text": "Arrays are stored in contiguous memory locations—a single, solid block of space.\nBecause of this, Arrays are indexed. You can instantly pick an element using its\nindex (e.g., myArray[2]), which is highly efficient because the index calculates\nthe exact memory address instantly.",
			"rawText": "Arrays are stored in contiguous memory locations—a single, solid block of space. Because of this, Arrays are indexed. You can instantly pick an element using its index (e.g., myArray[2]), which is highly efficient because the index calculates the exact memory address instantly.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": "BDnJIOpV",
			"originalText": "Arrays are stored in contiguous memory locations—a single, solid block of space. Because of this, Arrays are indexed. You can instantly pick an element using its index (e.g., myArray[2]), which is highly efficient because the index calculates the exact memory address instantly.",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
		{
			"id": "Bgl0QkPa",
			"type": "rectangle",
			"x": -419.87431761369123,
			"y": 2230.474178931552,
			"width": 927.6871267058916,
			"height": 110,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "dashed",
			"roughness": 0,
