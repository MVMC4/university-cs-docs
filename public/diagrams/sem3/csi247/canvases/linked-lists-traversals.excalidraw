			"updated": 1783358672060,
			"locked": false,
			"text": "In Java, you don't need to manually free memory (like free() in C). \nIf a Node has nothing pointing to it, the Java Garbage Collector automatically\ndestroys it.",
			"rawText": "In Java, you don't need to manually free memory (like free() in C). \nIf a Node has nothing pointing to it, the Java Garbage Collector automatically destroys it.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": "ITqzohtf",
			"originalText": "In Java, you don't need to manually free memory (like free() in C). \nIf a Node has nothing pointing to it, the Java Garbage Collector automatically destroys it.",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
