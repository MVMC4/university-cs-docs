			"boundElements": [],
			"updated": 1783370483269,
			"locked": false,
			"text": "Time Complexity: O(n) — Linear time.\n- Explanation: Same logic as inserting in the middle. The act of bypassing a node is O(1), but traversing to \n  index - 1 takes O(n).",
			"rawText": "Time Complexity: O(n) — Linear time.\n- Explanation: Same logic as inserting in the middle. The act of bypassing a node is O(1), but traversing to \n  index - 1 takes O(n).",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": "SnhbYx497u4-clcJsjqpy",
			"originalText": "Time Complexity: O(n) — Linear time.\n- Explanation: Same logic as inserting in the middle. The act of bypassing a node is O(1), but traversing to \n  index - 1 takes O(n).",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
		{
			"id": "f_1_hOAf6xQfAgsse2jHA",
			"type": "rectangle",
			"x": 2009.2503615335072,
			"y": 3480.994599641428,
			"width": 1240.9588068623234,
			"height": 110,
			"angle": 0,
			"strokeColor": "#1e1e1e",
