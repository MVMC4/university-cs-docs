			"text": "2. Circular Linked Lists (CLL)",
			"rawText": "2. Circular Linked Lists (CLL)",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
