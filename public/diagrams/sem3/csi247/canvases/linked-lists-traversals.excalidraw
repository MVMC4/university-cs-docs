			"versionNonce": 340769111,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1783373525219,
			"link": null,
			"locked": false,
			"text": "Each node contains three distinct fields: the data payload, a forward pointer (next), and a\nbackward pointer (prev).",
			"rawText": "Each node contains three distinct fields: the data payload, a forward pointer (next), and a backward pointer (prev).",
			"fontSize": 20,
			"fontFamily": 8,
