			"locked": false,
			"hasTextLink": false
		},
		{
			"id": "iF5DdVOZ",
			"type": "text",
			"x": 713.1967082393251,
			"y": 3316.5835079973094,
			"width": 1099.9986572265625,
			"height": 100,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "#e7f5ff",
			"fillStyle": "solid",
			"strokeWidth": 0.5,
			"strokeStyle": "dashed",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b1Q",
			"roundness": null,
			"seed": 2078069,
			"version": 1258,
			"versionNonce": 272272315,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1783355551787,
			"locked": false,
			"text": "Time Complexity: O(1) — Constant time.\n - Explanation: Because we maintain a tail pointer, we don't have to search for the end of the list.\n   We just tell the current tail to point to the new node, and then update our tail reference. \n   It takes the same amount of time whether the list has 10 items or 10 million.",
			"rawText": "Time Complexity: O(1) — Constant time.\n - Explanation: Because we maintain a tail pointer, we don't have to search for the end of the list. \n   We just tell the current tail to point to the new node, and then update our tail reference. \n   It takes the same amount of time whether the list has 10 items or 10 million.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": "fjmnEvbb",
			"originalText": "Time Complexity: O(1) — Constant time.\n - Explanation: Because we maintain a tail pointer, we don't have to search for the end of the list. \n   We just tell the current tail to point to the new node, and then update our tail reference. \n   It takes the same amount of time whether the list has 10 items or 10 million.",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
