		{
			"id": "lIRrqBkK",
			"type": "text",
			"x": 4677.3724635971685,
			"y": 1219.370751279239,
			"width": 974.7814747961988,
			"height": 75,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "#e3fafc",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
