			"versionNonce": 871127157,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1783355134088,
			"locked": false,
			"text": "To insert in the middle, you must find the node just before your target index. \nIf you break the chain before connecting your new node, the rest of the list is lost to Java's Garbage Collector. \nAlways connect the new node to the right side first!",
			"rawText": "To insert in the middle, you must find the node just before your target index. \nIf you break the chain before connecting your new node, the rest of the list is lost to Java's Garbage Collector. \nAlways connect the new node to the right side first!",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "To insert in the middle, you must find the node just before your target index. \nIf you break the chain before connecting your new node, the rest of the list is lost to Java's Garbage Collector. \nAlways connect the new node to the right side first!",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
