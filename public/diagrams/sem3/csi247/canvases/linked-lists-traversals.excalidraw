		{
			"id": "lbqo6QOr",
			"type": "text",
			"x": -411.6938265135837,
			"y": 1285.588204907824,
			"width": 912.9989013671875,
			"height": 200,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "#e7f5ff",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "dashed",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b0Q",
