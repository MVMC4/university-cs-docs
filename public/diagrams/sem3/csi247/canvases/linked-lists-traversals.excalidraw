			"seed": 761078263,
			"version": 259,
			"versionNonce": 682827801,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1783369563059,
			"locked": false,
			"text": "Time Complexity: O(n) across all cases. You cannot print a list without looking at every single node exactly\nonce.\nSpace Complexity: O(1). You are only spinning up a single temporary tracking pointer (currentNode), regardless\nof how long the list is.",
			"rawText": "Time Complexity: O(n) across all cases. You cannot print a list without looking at every single node exactly once.\nSpace Complexity: O(1). You are only spinning up a single temporary tracking pointer (currentNode), regardless of how long the list is.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": "7N1kyaHl",
			"originalText": "Time Complexity: O(n) across all cases. You cannot print a list without looking at every single node exactly once.\nSpace Complexity: O(1). You are only spinning up a single temporary tracking pointer (currentNode), regardless of how long the list is.",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
