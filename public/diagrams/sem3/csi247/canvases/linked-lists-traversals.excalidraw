		{
			"id": "BDnJIOpV",
			"type": "rectangle",
			"x": -420.4021671580352,
			"y": 2052.898049716819,
			"width": 927.9046484191438,
			"height": 110,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "dashed",
