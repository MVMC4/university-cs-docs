		{
			"id": "88hWSW4R",
			"type": "text",
			"x": 3365.9331031067095,
			"y": 5567.862999119602,
			"width": 1209.9984130859375,
			"height": 125,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "dashed",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b4T",
			"roundness": null,
			"seed": 537152057,
			"version": 883,
			"versionNonce": 1868972857,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1783371118334,
			"locked": false,
			"text": "Time Complexity: O(n) Linear time execution. Every node in the sequence must be visited exactly once to adjust\nits pointer property. The operation scales in direct proportion to the size of n.\nSpace Complexity: O(1) Constant space execution. \nPointers are mutated in-place by updating existing heap reference variables. No duplicate allocations or\nstructural copies are created.",
			"rawText": "Time Complexity: O(n) Linear time execution. Every node in the sequence must be visited exactly once to adjust its pointer property. The operation scales in direct proportion to the size of n.\nSpace Complexity: O(1) Constant space execution. \nPointers are mutated in-place by updating existing heap reference variables. No duplicate allocations or structural copies are created.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": "YWvQ4ZTU",
			"originalText": "Time Complexity: O(n) Linear time execution. Every node in the sequence must be visited exactly once to adjust its pointer property. The operation scales in direct proportion to the size of n.\nSpace Complexity: O(1) Constant space execution. \nPointers are mutated in-place by updating existing heap reference variables. No duplicate allocations or structural copies are created.",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
