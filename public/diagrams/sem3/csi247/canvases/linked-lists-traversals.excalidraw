			"version": 941,
			"versionNonce": 667918489,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1783370255297,
			"locked": false,
			"text": "Time Complexity: O(1) — Constant time.\n- Explanation: You just move the head pointer forward one step. \n  Java's Garbage Collector will automatically destroy the old head since nothing is pointing to it anymore.",
			"rawText": "Time Complexity: O(1) — Constant time.\n- Explanation: You just move the head pointer forward one step. \n  Java's Garbage Collector will automatically destroy the old head since nothing is pointing to it anymore.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": "sLlmUjcWO-6PN-_0MYh1f",
			"originalText": "Time Complexity: O(1) — Constant time.\n- Explanation: You just move the head pointer forward one step. \n  Java's Garbage Collector will automatically destroy the old head since nothing is pointing to it anymore.",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
		{
			"id": "JGc79vCc",
			"type": "text",
			"x": 1995.106528332084,
			"y": 1611.1824343761366,
