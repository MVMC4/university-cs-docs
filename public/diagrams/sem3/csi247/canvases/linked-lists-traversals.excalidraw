		{
			"id": "bsPGipuD",
			"type": "text",
			"x": 5762.986964893951,
			"y": 497.36040092428186,
			"width": 1011.9986572265625,
			"height": 50,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "dashed",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b5s",
			"roundness": null,
			"seed": 1869551660,
			"version": 95,
			"versionNonce": 1922047148,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1783375806055,
			"locked": false,
			"text": "While the algorithmic intent of a linear traversal remains identical across structures, the \nlow-level hardware execution differs based on how the data is organized in memory:",
			"rawText": "While the algorithmic intent of a linear traversal remains identical across structures, the \nlow-level hardware execution differs based on how the data is organized in memory:",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "While the algorithmic intent of a linear traversal remains identical across structures, the \nlow-level hardware execution differs based on how the data is organized in memory:",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
		{
			"id": "HCGAqJmB",
			"type": "rectangle",
			"x": 5767.24163907173,
			"y": 572.048646037734,
			"width": 1025.7446698023743,
			"height": 360,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "dashed",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b5t",
			"roundness": null,
			"seed": 1575964844,
			"version": 170,
			"versionNonce": 1401836564,
			"isDeleted": false,
			"boundElements": [
