		},
		{
			"id": "T3UWkKqH",
			"type": "text",
			"x": 4677.438735885328,
			"y": 1836.290232340926,
			"width": 987.7420462988806,
			"height": 75,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "#e3fafc",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b58",
			"roundness": null,
			"seed": 2047454969,
			"version": 561,
			"versionNonce": 1736549783,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1783373478818,
			"link": null,
			"locked": false,
			"text": "The primary trade-off of a Doubly Linked List is increased pointer management overhead.\nInserting a node into the middle of a DLL requires mutating four separate reference paths\ninstead of two. The order of execution is critical to prevent orphaning adjacent nodes.",
			"rawText": "The primary trade-off of a Doubly Linked List is increased pointer management overhead. Inserting a node into the middle of a DLL requires mutating four separate reference paths instead of two. The order of execution is critical to prevent orphaning adjacent nodes.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "The primary trade-off of a Doubly Linked List is increased pointer management overhead. Inserting a node into the middle of a DLL requires mutating four separate reference paths instead of two. The order of execution is critical to prevent orphaning adjacent nodes.",
			"autoResize": false,
			"lineHeight": 1.25,
			"hasTextLink": false
		},
