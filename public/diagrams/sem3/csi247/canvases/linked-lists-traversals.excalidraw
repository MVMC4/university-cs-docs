		{
			"id": "JMAWev2d",
			"type": "text",
			"x": -414.91624752197873,
			"y": 2600.5172179808155,
			"width": 967.9989013671875,
			"height": 350,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "dashed",
