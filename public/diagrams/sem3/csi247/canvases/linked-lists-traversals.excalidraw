			"version": 462,
			"versionNonce": 240158073,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1783372074849,
			"locked": false,
			"text": "1. previousNode: Tracks the node immediately preceding the execution focus. This serves as the target address \n   that the current node’s pointer will loop back to reference. (Initialized to null).\n2. currentNode: Tracks the node actively undergoing pointer mutation. (Initialized to head).\n3. nextNode: Acts as a temporary memory cache (a lifeboat reference) that secures downstream nodes before any \n   pointer links are severed.",
			"rawText": "1. previousNode: Tracks the node immediately preceding the execution focus. This serves as the target address \n   that the current node’s pointer will loop back to reference. (Initialized to null).\n2. currentNode: Tracks the node actively undergoing pointer mutation. (Initialized to head).\n3. nextNode: Acts as a temporary memory cache (a lifeboat reference) that secures downstream nodes before any \n   pointer links are severed.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "bottom",
			"containerId": "yyC4DHTW",
			"originalText": "1. previousNode: Tracks the node immediately preceding the execution focus. This serves as the target address \n   that the current node’s pointer will loop back to reference. (Initialized to null).\n2. currentNode: Tracks the node actively undergoing pointer mutation. (Initialized to head).\n3. nextNode: Acts as a temporary memory cache (a lifeboat reference) that secures downstream nodes before any \n   pointer links are severed.",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
