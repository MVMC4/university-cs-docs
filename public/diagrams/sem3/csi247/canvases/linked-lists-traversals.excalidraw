			"seed": 384116590,
			"version": 720,
			"versionNonce": 1914774581,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1783350667405,
			"locked": false,
			"text": "If this is your first time looking at Linked Lists, you might think, \n\"What is the point? This is just an Array with extra steps.\"\n\nArrays (and Java's dynamic ArrayList) and Linked Lists are both \"Linear data\nstructures.\" \nTheir elements are arranged sequentially, making it possible to traverse them in a\nsingle run. \nHowever, the main difference lies in how their data is physically stored in memory.",
			"rawText": "If this is your first time looking at Linked Lists, you might think, \n\"What is the point? This is just an Array with extra steps.\"\n\nArrays (and Java's dynamic ArrayList) and Linked Lists are both \"Linear data structures.\" \nTheir elements are arranged sequentially, making it possible to traverse them in a single run. \nHowever, the main difference lies in how their data is physically stored in memory.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": "cLNEN0Wh",
			"originalText": "If this is your first time looking at Linked Lists, you might think, \n\"What is the point? This is just an Array with extra steps.\"\n\nArrays (and Java's dynamic ArrayList) and Linked Lists are both \"Linear data structures.\" \nTheir elements are arranged sequentially, making it possible to traverse them in a single run. \nHowever, the main difference lies in how their data is physically stored in memory.",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
