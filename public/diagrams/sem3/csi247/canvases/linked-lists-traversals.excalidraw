			"updated": 1783352545789,
			"locked": false,
			"text": "1.2 The LinkedList Manager Class\n\nIt needs to keep track of the head, the tail, and an optional length.",
			"rawText": "1.2 The LinkedList Manager Class\n\nIt needs to keep track of the head, the tail, and an optional length.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "1.2 The LinkedList Manager Class\n\nIt needs to keep track of the head, the tail, and an optional length.",
			"autoResize": false,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
		{
			"id": "ophrFjUO",
			"type": "text",
			"x": 696.6678681379444,
			"y": 1871.4607505493468,
			"width": 1127.5186767578125,
			"height": 150,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "dashed",
