			"isDeleted": false,
			"boundElements": [],
			"updated": 1783370798676,
			"link": null,
			"locked": false,
			"text": "Reversing a singly linked list in-place requires mutating the pointer direction of every node in the sequence\nwithout copying the underlying data payloads. Because a singly linked list is unidirectional, a structural\nreversal requires a multi-pointer strategy to prevent losing memory access references during execution.",
			"rawText": "Reversing a singly linked list in-place requires mutating the pointer direction of every node in the sequence without copying the underlying data payloads. Because a singly linked list is unidirectional, a structural reversal requires a multi-pointer strategy to prevent losing memory access references during execution.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Reversing a singly linked list in-place requires mutating the pointer direction of every node in the sequence without copying the underlying data payloads. Because a singly linked list is unidirectional, a structural reversal requires a multi-pointer strategy to prevent losing memory access references during execution.",
			"autoResize": false,
			"lineHeight": 1.25,
			"hasTextLink": false
		},
