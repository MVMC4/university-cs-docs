		{
			"id": "xbz9oHnm",
			"type": "text",
			"x": 703.7482725183625,
			"y": 2646.1087681622002,
			"width": 1176.99853515625,
			"height": 200,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "dashed",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b1NV",
			"roundness": null,
			"seed": 1653025883,
			"version": 1179,
			"versionNonce": 1653634971,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1783353364102,
			"locked": false,
			"text": "Hold on, what is going on with the head and tail?\nThis is a classic point of confusion.\nWhen the list is empty, head and tail both point to the exact same memory address (the newNode).\nWhen you do this.tail.next = newNode in a list that only has one item, you are modifying the memory address\nthat head is also pointing to. \nBecause they are references to the same object, this.head.next automatically updates as well!\nThen, this.tail = newNode simply breaks the tail's connection to the first object and moves it to the\nsecond object. head stays behind at the start.",
			"rawText": "Hold on, what is going on with the head and tail?\nThis is a classic point of confusion.\nWhen the list is empty, head and tail both point to the exact same memory address (the newNode).\nWhen you do this.tail.next = newNode in a list that only has one item, you are modifying the memory address that head is also pointing to. \nBecause they are references to the same object, this.head.next automatically updates as well!\nThen, this.tail = newNode simply breaks the tail's connection to the first object and moves it to the second object. head stays behind at the start.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": "aB33M4BW",
			"originalText": "Hold on, what is going on with the head and tail?\nThis is a classic point of confusion.\nWhen the list is empty, head and tail both point to the exact same memory address (the newNode).\nWhen you do this.tail.next = newNode in a list that only has one item, you are modifying the memory address that head is also pointing to. \nBecause they are references to the same object, this.head.next automatically updates as well!\nThen, this.tail = newNode simply breaks the tail's connection to the first object and moves it to the second object. head stays behind at the start.",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
		{
			"id": "fjmnEvbb",
			"type": "rectangle",
			"x": 708.1967082393251,
			"y": 3311.5835079973094,
			"width": 1115.2702809784844,
			"height": 110,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "#fff9db",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "dashed",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b1P",
			"roundness": null,
			"seed": 1466232277,
			"version": 1391,
			"versionNonce": 1178168311,
			"isDeleted": false,
			"boundElements": [
