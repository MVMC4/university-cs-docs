			"locked": false,
			"hasTextLink": false
		},
		{
			"id": "YDIEaTfz",
			"type": "text",
			"x": -414.87431761369123,
			"y": 2235.474178931552,
			"width": 912.9989624023438,
			"height": 100,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "dashed",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b0f",
			"roundness": null,
			"seed": 1926726638,
			"version": 220,
			"versionNonce": 1596772181,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1783350667405,
			"locked": false,
			"text": "Linked Lists are not contiguous. Every time you create a new Node in Java using the\nnew keyword, it is placed wherever there is free space in the heap memory. They are\nscattered. To find an element, we cannot use an index; we have to follow the trail\nof next pointers from the HEAD until we find our target.",
			"rawText": "Linked Lists are not contiguous. Every time you create a new Node in Java using the new keyword, it is placed wherever there is free space in the heap memory. They are scattered. To find an element, we cannot use an index; we have to follow the trail of next pointers from the HEAD until we find our target.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": "Bgl0QkPa",
			"originalText": "Linked Lists are not contiguous. Every time you create a new Node in Java using the new keyword, it is placed wherever there is free space in the heap memory. They are scattered. To find an element, we cannot use an index; we have to follow the trail of next pointers from the HEAD until we find our target.",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
