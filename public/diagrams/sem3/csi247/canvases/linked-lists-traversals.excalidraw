			"isDeleted": false,
			"boundElements": [],
			"updated": 1783373709646,
			"locked": false,
			"text": "1. Singly-Circular Linked List: The tail.next reference pointer loops back to target the \n   head node. Nodes retain single-pointer unidirectional properties.",
			"rawText": "1. Singly-Circular Linked List: The tail.next reference pointer loops back to target the \n   head node. Nodes retain single-pointer unidirectional properties.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "1. Singly-Circular Linked List: The tail.next reference pointer loops back to target the \n   head node. Nodes retain single-pointer unidirectional properties.",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
		{
			"id": "74limZN2",
			"type": "text",
			"x": 4675.028526422019,
			"y": 2866.5801613011813,
			"width": 989.9988403320312,
			"height": 50,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "dashed",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b5f",
			"roundness": null,
			"seed": 115908247,
			"version": 102,
			"versionNonce": 98798199,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1783373706801,
			"locked": false,
			"text": "2. Doubly-Circular Linked List: The tail.next points to the head, and the head.prev loops \n   backward to target the tail node, establishing absolute bidirectional continuity.",
			"rawText": "2. Doubly-Circular Linked List: The tail.next points to the head, and the head.prev loops \n   backward to target the tail node, establishing absolute bidirectional continuity.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "2. Doubly-Circular Linked List: The tail.next points to the head, and the head.prev loops \n   backward to target the tail node, establishing absolute bidirectional continuity.",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
