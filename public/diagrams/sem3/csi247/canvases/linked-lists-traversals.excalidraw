		{
			"id": "aB33M4BW",
			"type": "rectangle",
			"x": 698.7482725183625,
			"y": 2641.1087681622002,
			"width": 1196.6686160554532,
			"height": 210,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "#e3fafc",
			"fillStyle": "solid",
			"strokeWidth": 1,
