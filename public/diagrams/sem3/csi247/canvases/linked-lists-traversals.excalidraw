		{
			"id": "tJnQdD5M",
			"type": "text",
			"x": 2001.5660308505749,
			"y": 346.45288887329673,
			"width": 1253.9984130859375,
			"height": 75,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
