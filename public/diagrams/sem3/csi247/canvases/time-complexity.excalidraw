			"updated": 1783437033105,
			"link": null,
			"locked": false,
			"text": "When analyzing code or structures, your goal is to categorize the runtime into one of these\nstandard mathematical buckets, ordered from fastest to slowest:",
			"rawText": "When analyzing code or structures, your goal is to categorize the runtime into one of these standard mathematical buckets, ordered from fastest to slowest:",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "When analyzing code or structures, your goal is to categorize the runtime into one of these standard mathematical buckets, ordered from fastest to slowest:",
			"autoResize": false,
			"lineHeight": 1.25,
			"hasTextLink": false
		},
		{
			"id": "hKEQWWSgt5wbgrflhXnKc",
			"type": "rectangle",
			"x": -1329.8686938121232,
			"y": 121.09894608542368,
			"width": 1027.500419,
			"height": 835,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "dashed",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "as",
			"roundness": null,
			"seed": 1483247508,
			"version": 2331,
			"versionNonce": 723458791,
			"isDeleted": false,
			"boundElements": [
