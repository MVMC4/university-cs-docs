		{
			"id": "mPv4JXvk",
			"type": "text",
			"x": -1324.1295576945454,
			"y": -756.1274580854774,
			"width": 1000.9987182617188,
			"height": 75,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
