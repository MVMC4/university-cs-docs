			"isDeleted": false,
			"boundElements": [],
			"updated": 1783427514384,
			"locked": false,
			"text": "Runtime depends heavily on the input data (e.g., searching a sorted vs. unsorted array) and\nincreases as the input size (n) increases. Furthermore, a program running on a legacy\nworkstation will clock a slower time than the exact same code on a modern high-end machine.",
			"rawText": "Runtime depends heavily on the input data (e.g., searching a sorted vs. unsorted array) and increases as the input size (n) increases. Furthermore, a program running on a legacy workstation will clock a slower time than the exact same code on a modern high-end machine.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "middle",
			"containerId": "O76TvfxF",
			"originalText": "Runtime depends heavily on the input data (e.g., searching a sorted vs. unsorted array) and increases as the input size (n) increases. Furthermore, a program running on a legacy workstation will clock a slower time than the exact same code on a modern high-end machine.",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
