		{
			"id": "U6sVIlFs",
			"type": "text",
			"x": -208.95720242504058,
			"y": -2723.361931297101,
			"width": 824.9990234375,
			"height": 100,
			"angle": 0,
			"strokeColor": "#1e1e1e",
