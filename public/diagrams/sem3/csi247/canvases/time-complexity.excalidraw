		{
			"id": "4zONdtaa",
			"type": "text",
			"x": -209.58434630934335,
			"y": -3420.9602644687357,
			"width": 1012.998779296875,
			"height": 275,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "#e3fafc",
			"fillStyle": "solid",
