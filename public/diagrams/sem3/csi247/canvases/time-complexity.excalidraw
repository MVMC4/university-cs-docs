			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b19",
			"roundness": null,
			"seed": 423759944,
			"version": 116,
			"versionNonce": 932379448,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1783431577491,
			"locked": false,
			"text": "Big-O Notation (O):  Provides a formal way to express the Worst-Case growth rate.\n - \"f(n) is O(g(n))\" means the growth rate of f(n) does not exceed the growth rate of g(n).\n - Example: 10n - 2 ≈ n → O(n).",
			"rawText": "Big-O Notation (O):  Provides a formal way to express the Worst-Case growth rate.\n - \"f(n) is O(g(n))\" means the growth rate of f(n) does not exceed the growth rate of g(n).\n - Example: 10n - 2 ≈ n → O(n).",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": "s40GPcG4",
			"originalText": "Big-O Notation (O):  Provides a formal way to express the Worst-Case growth rate.\n - \"f(n) is O(g(n))\" means the growth rate of f(n) does not exceed the growth rate of g(n).\n - Example: 10n - 2 ≈ n → O(n).",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
		{
			"id": "llq19T5Z",
