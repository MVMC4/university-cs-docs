			"type": "text",
			"x": -1335.615042738378,
			"y": -606.4055103269789,
			"width": 1030.4009698208679,
			"height": 150,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "dashed",
			"roughness": 0,
