		{
			"id": "fFi2WrtC",
			"type": "text",
			"x": -255.9619567144972,
			"y": -474.40559788512905,
			"width": 1011.4830828178287,
			"height": 100,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "dotted",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b06",
			"roundness": null,
			"seed": 743311252,
			"version": 634,
			"versionNonce": 2114682796,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1783412382195,
			"locked": false,
			"text": "A Queue is a linear ADT operating strictly on the First-In, First-Out (FIFO) principle.\nElements are organized symmetrically: insertions occur at one dedicated boundary labeled\nthe Back (or Rear), while removals occur at the opposite terminal boundary labeled the\nFront.",
			"rawText": "A Queue is a linear ADT operating strictly on the First-In, First-Out (FIFO) principle. Elements are organized symmetrically: insertions occur at one dedicated boundary labeled the Back (or Rear), while removals occur at the opposite terminal boundary labeled the Front.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "A Queue is a linear ADT operating strictly on the First-In, First-Out (FIFO) principle. Elements are organized symmetrically: insertions occur at one dedicated boundary labeled the Back (or Rear), while removals occur at the opposite terminal boundary labeled the Front.",
			"autoResize": false,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
