		{
			"id": "6kkSG9Ft",
			"type": "text",
			"x": 856.2386496983609,
			"y": -480.292712318344,
			"width": 1011.4830828178287,
			"height": 75,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "dotted",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b1V",
			"roundness": null,
			"seed": 728558124,
			"version": 713,
			"versionNonce": 523204012,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1783413281058,
			"locked": false,
			"text": "A Circular Queue is a fixed-size, array-based implementation of a queue where the last\nposition connects back to the first position. \nThis structure optimizes memory reuse by turning a linear array into an endless circle.",
			"rawText": "A Circular Queue is a fixed-size, array-based implementation of a queue where the last position connects back to the first position. \nThis structure optimizes memory reuse by turning a linear array into an endless circle.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "A Circular Queue is a fixed-size, array-based implementation of a queue where the last position connects back to the first position. \nThis structure optimizes memory reuse by turning a linear array into an endless circle.",
			"autoResize": false,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
