		{
			"id": "5u7Q4BvG",
			"type": "text",
			"x": -1367.6482964949357,
			"y": 2746.938453289014,
			"width": 978.998779296875,
			"height": 150,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "dashed",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b00V",
			"roundness": null,
			"seed": 1160224300,
			"version": 323,
			"versionNonce": 487906708,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1783417844309,
			"locked": false,
			"text": "The Proof: Because access bounds are artificially confined to the top reference node (the\nlist origin), state mutations never trigger iteration. \nInserting or removing an element modifies an immediate, explicit pointer address without\nwalking the remaining $n$ downstream items. \nHence, execution performance scales independently of size, guaranteeing constant\nmathematical time, O(1).",
			"rawText": "The Proof: Because access bounds are artificially confined to the top reference node (the list origin), state mutations never trigger iteration. \nInserting or removing an element modifies an immediate, explicit pointer address without walking the remaining $n$ downstream items. \nHence, execution performance scales independently of size, guaranteeing constant mathematical time, O(1).",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": "izUXwFi4",
			"originalText": "The Proof: Because access bounds are artificially confined to the top reference node (the list origin), state mutations never trigger iteration. \nInserting or removing an element modifies an immediate, explicit pointer address without walking the remaining $n$ downstream items. \nHence, execution performance scales independently of size, guaranteeing constant mathematical time, O(1).",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
