			"boundElements": [],
			"updated": 1783417844308,
			"locked": false,
			"text": "Conceptually, a Stack maps directly to a Singly Linked List restricted to its head pointer.\nYou interact with the structure via five primary operations:",
			"rawText": "Conceptually, a Stack maps directly to a Singly Linked List restricted to its head pointer. You interact with the structure via five primary operations:",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Conceptually, a Stack maps directly to a Singly Linked List restricted to its head pointer. You interact with the structure via five primary operations:",
			"autoResize": false,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
