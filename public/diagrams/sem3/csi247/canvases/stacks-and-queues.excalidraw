		{
			"id": "KKicaEs3",
			"type": "text",
			"x": -1371.973615269298,
			"y": 1905.7292349969339,
			"width": 1011.4830828178287,
			"height": 100,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "dotted",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
