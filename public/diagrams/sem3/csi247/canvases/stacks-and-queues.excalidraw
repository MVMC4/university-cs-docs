			"seed": 1024612396,
			"version": 252,
			"versionNonce": 2084575148,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1783415840160,
			"locked": false,
			"text": "Instead of incrementing pointers linearly (index++), indices are stepped forward using modulo\narithmetic (%) relative to the total capacity of the array. \n\nThis causes pointers to naturally snap back to index 0 once they cross the array boundary.",
			"rawText": "Instead of incrementing pointers linearly (index++), indices are stepped forward using modulo arithmetic (%) relative to the total capacity of the array. \n\nThis causes pointers to naturally snap back to index 0 once they cross the array boundary.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Instead of incrementing pointers linearly (index++), indices are stepped forward using modulo arithmetic (%) relative to the total capacity of the array. \n\nThis causes pointers to naturally snap back to index 0 once they cross the array boundary.",
			"autoResize": false,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
