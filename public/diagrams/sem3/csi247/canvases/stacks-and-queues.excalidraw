			"index": "al",
			"roundness": null,
			"seed": 551878956,
			"version": 274,
			"versionNonce": 1533362732,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1783417844308,
			"locked": false,
			"text": "A spring-loaded stack of plates in a cafeteria. \nYou can only place a new plate onto the very top, and you can only retrieve a plate from the\nvery top. \nAttempting to extract from the middle or bottom compromises structural stability.",
			"rawText": "A spring-loaded stack of plates in a cafeteria. \nYou can only place a new plate onto the very top, and you can only retrieve a plate from the very top. \nAttempting to extract from the middle or bottom compromises structural stability.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "A spring-loaded stack of plates in a cafeteria. \nYou can only place a new plate onto the very top, and you can only retrieve a plate from the very top. \nAttempting to extract from the middle or bottom compromises structural stability.",
			"autoResize": false,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
