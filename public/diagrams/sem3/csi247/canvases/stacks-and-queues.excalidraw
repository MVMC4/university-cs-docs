		{
			"id": "M3RYt77S",
			"type": "text",
			"x": -1361.3505222470171,
			"y": 31.384048587030463,
			"width": 1017.1700825739869,
			"height": 100,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
