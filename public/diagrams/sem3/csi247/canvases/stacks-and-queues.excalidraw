		{
			"id": "IpMMWp98",
			"type": "text",
			"x": 1965.7434256194924,
			"y": 1661.410066479661,
			"width": 993.2959448211933,
			"height": 375,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 1,
