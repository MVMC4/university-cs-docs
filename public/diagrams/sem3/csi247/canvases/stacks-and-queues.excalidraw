		{
			"id": "7aWcVqZO",
			"type": "text",
			"x": -255.09761627453554,
			"y": 2146.1431636906077,
			"width": 1048.699229747278,
			"height": 75,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "dotted",
