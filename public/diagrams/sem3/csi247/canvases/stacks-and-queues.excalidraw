			"index": "b0O",
			"roundness": null,
			"seed": 2109115028,
			"version": 1070,
			"versionNonce": 692394132,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1783410499158,
			"locked": false,
			"text": "Queues are implemented to preserve exact chronological entry order. \nWhen access to a single shared computing resource (such as a hardware CPU core or network\ninterface) is limited, a Queue distributes access logically and fairly based on arrival time.",
			"rawText": "Queues are implemented to preserve exact chronological entry order. \nWhen access to a single shared computing resource (such as a hardware CPU core or network interface) is limited, a Queue distributes access logically and fairly based on arrival time.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Queues are implemented to preserve exact chronological entry order. \nWhen access to a single shared computing resource (such as a hardware CPU core or network interface) is limited, a Queue distributes access logically and fairly based on arrival time.",
			"autoResize": false,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
