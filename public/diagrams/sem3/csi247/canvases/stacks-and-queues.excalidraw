		{
			"id": "kJXbb0Fk",
			"type": "text",
			"x": 863.8066127680962,
			"y": -5.609786029830275,
			"width": 1017.1700825739869,
			"height": 125,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "dashed",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b1a",
			"roundness": null,
			"seed": 985206444,
			"version": 485,
			"versionNonce": 1634531628,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1783413510287,
			"locked": false,
			"text": "Consider a scenario where you're simulating a printer queue. \nNew documents are constantly being added to the queue, and as they are printed, they are\nremoved. \nIn a circular queue, if the queue becomes full and documents are printed, new documents can\nstill be added at the beginning of the queue, as it is circular in nature.",
			"rawText": "Consider a scenario where you're simulating a printer queue. \nNew documents are constantly being added to the queue, and as they are printed, they are removed. \nIn a circular queue, if the queue becomes full and documents are printed, new documents can still be added at the beginning of the queue, as it is circular in nature.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Consider a scenario where you're simulating a printer queue. \nNew documents are constantly being added to the queue, and as they are printed, they are removed. \nIn a circular queue, if the queue becomes full and documents are printed, new documents can still be added at the beginning of the queue, as it is circular in nature.",
			"autoResize": false,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
		{
			"id": "k7I6foOK",
