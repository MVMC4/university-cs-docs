		{
			"id": "yIFB6flr",
			"type": "text",
			"x": -1389.7386071411731,
			"y": -1201.5777130328654,
			"width": 923.9989013671875,
			"height": 225,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
