			"seed": 1492710572,
			"version": 504,
			"versionNonce": 1612389012,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1783417844308,
			"locked": false,
			"text": "A Stack is a linear ADT operating strictly on the Last-In, First-Out (LIFO) principle. \nIt establishes a restricted access pattern where both the insertion of new elements and the\nremoval of existing elements occur exclusively at the same terminal boundary, designated as\nthe Top.",
			"rawText": "A Stack is a linear ADT operating strictly on the Last-In, First-Out (LIFO) principle. \nIt establishes a restricted access pattern where both the insertion of new elements and the removal of existing elements occur exclusively at the same terminal boundary, designated as the Top.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "A Stack is a linear ADT operating strictly on the Last-In, First-Out (LIFO) principle. \nIt establishes a restricted access pattern where both the insertion of new elements and the removal of existing elements occur exclusively at the same terminal boundary, designated as the Top.",
			"autoResize": false,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
