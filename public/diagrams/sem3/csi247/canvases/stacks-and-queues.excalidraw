		{
			"id": "ebG1WyyO",
			"type": "text",
			"x": 854.8095493035739,
			"y": 1957.9028760103288,
			"width": 1010.3275472238247,
			"height": 175,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "dashed",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b1z",
			"roundness": null,
			"seed": 1125842068,
			"version": 262,
			"versionNonce": 845178772,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1783415856348,
			"locked": false,
			"text": "Compilers cannot easily evaluate standard mathematical expressions written in Infix\nnotation (e.g., A + B x C) because human notation relies heavily on ambiguous precedence\nrules (PEMDAS) and overriding parentheses.\n\nTo evaluate arithmetic in a single linear pass without backtracking, compilers translate\nexpressions into Postfix notation (Reverse Polish Notation, e.g., A B C x +), where\noperators strictly follow their respective operands.",
			"rawText": "Compilers cannot easily evaluate standard mathematical expressions written in Infix notation (e.g., A + B x C) because human notation relies heavily on ambiguous precedence rules (PEMDAS) and overriding parentheses.\n\nTo evaluate arithmetic in a single linear pass without backtracking, compilers translate expressions into Postfix notation (Reverse Polish Notation, e.g., A B C x +), where operators strictly follow their respective operands.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Compilers cannot easily evaluate standard mathematical expressions written in Infix notation (e.g., A + B x C) because human notation relies heavily on ambiguous precedence rules (PEMDAS) and overriding parentheses.\n\nTo evaluate arithmetic in a single linear pass without backtracking, compilers translate expressions into Postfix notation (Reverse Polish Notation, e.g., A B C x +), where operators strictly follow their respective operands.",
			"autoResize": false,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
